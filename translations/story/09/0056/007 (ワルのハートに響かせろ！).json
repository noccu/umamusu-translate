            "pathId": -8858732557568522038,
            "blockIdx": 4
        },
        {
            "jpName": "フェノーメノ",
            "enName": "Fenomeno",
            "jpText": "そして――ウインディさんの“悪知恵とワルの考え”で見せる\n柔軟な思考！　私とは全く異なる発想力！",
            "enText": "<i>And Windy-san… Your cunning and villainous mind let you \nthink on your feet! You can see so many possibilities \nthat I never could!</i>",
            "nextBlock": 6,
            "origClipLength": 270,
            "voiceIdx": 4,
            "animData": [
                {
                    "origLen": 302,
                    "pathId": 3685771481524360312
                },
                {
                    "origLen": 14,
                    "pathId": -1577136785361358621
