            "pathId": -8920114609123343720,
            "blockIdx": 10
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "フフッ、『ホテリエ』よ！\n意外性もあってなかなかいいでしょ？",
            "enText": "Fufuu, 『Hotelier』! \nQuite the unexpected choice, don't you think?",
