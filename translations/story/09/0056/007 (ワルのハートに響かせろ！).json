                },
                {
                    "origLen": 50,
                    "pathId": 2094532117020514499
                },
                {
                    "origLen": 385,
                    "pathId": -2771544250358733588
                }
            ],
            "pathId": 8867961129336230150,
            "blockIdx": 2
        },
        {
            "jpName": "ビコーペガサス",
            "enName": "Biko Pegasus",
            "jpText": "落書きで連絡を取る方法は失敗かぁ……。\nウララ先輩に返事をくれたから、いけそうに思ったんだけどな。",
            "enText": "So writing on the wall to them didn't work… Dang. \nI figured we could get this figured out if they just replied to \nUrara-senpai.",
            "nextBlock": 4,
            "origClipLength": 291,
            "voiceIdx": 2,
            "animData": [
                {
                    "origLen": 10,
                    "pathId": -7141618035154718310
                },
                {
                    "origLen": 10,
                    "pathId": -8443923227160378791
                },
                {
                    "origLen": 90,
                    "pathId": -321443265758223473
                },
                {
                    "origLen": 342,
                    "pathId": -6148739809181369699
                },
                {
                    "origLen": 337,
                    "pathId": 6647642552754047053
                },
                {
                    "origLen": 335,
                    "pathId": -6919110122139174373
                },
                {
                    "origLen": 168,
                    "pathId": 6893907251730828782
                },
                {
                    "origLen": 340,
                    "pathId": 6402986716131829569
                }
            ],
            "pathId": -1356472387370848756,
            "blockIdx": 3
        },
        {
            "jpName": "サムソンビッグ",
            "enName": "Samson Big",
            "jpText": "警戒されてるのかも？\n風紀の取り締まりじゃないかって、ウワサになってたみたいだし。",
            "enText": "Maybe they're being careful. \nPeople are spreading rumors that the Disciplinary Committee \nmight be cracking down.",
            "nextBlock": 5,
            "origClipLength": 195,
            "voiceIdx": 3,
            "animData": [
                {
                    "origLen": 368,
                    "pathId": 1759716497865037354
                },
                {
                    "origLen": 287,
                    "pathId": 5325623541254840302
                },
                {
                    "origLen": 337,
                    "pathId": -8740775442190331643
                },
                {
                    "origLen": 335,
                    "pathId": 5446429742756105842
                },
                {
                    "origLen": 21,
                    "pathId": 2724602815917173879
                },
                {
                    "origLen": 48,
                    "pathId": 50862156786914821
