    "text": [
        {
            "jpName": "ライスシャワー",
            "enName": "Rice Shower",
            "jpText": "お、お誕生日おめでとう、ロブロイさん……！",
            "enText": "H-Happy birthday, Rob Roy!",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": 3372326812681808175,
            "blockIdx": 1
        },
        {
            "jpName": "スイープトウショウ",
            "enName": "Sweep Tosho",
            "jpText": "へー、今日誕生日なの？　なら、アタシが\r\nお願いごとが叶う魔法をかけてあげるわ！",
            "enText": "Oh, it's your birthday? Then I'll cast a spell \nthat'll make all your wishes come true!",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": -9114788752784051110,
            "blockIdx": 2
        },
        {
            "jpName": "ゼンノロブロイ",
            "enName": "Zenno Rob Roy",
            "jpText": "えへへ、お2人とも、\r\nありがとうございます……！",
            "enText": "Hehe, you two… thank you so much!",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": -3845479319396709079,
            "blockIdx": 3
        },
        {
            "jpName": "スイープトウショウ",
            "enName": "Sweep Tosho",
            "jpText": "フフン♪　こんなのどーってことないわよ。\r\nえーっとそれじゃ、目を閉じて――",
            "enText": "Hmph♪ This is nothing to me. \nUmm, okay, close your eyes…",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": 5511181713395288496,
            "blockIdx": 4
        },
        {
            "jpName": "スイープトウショウ",
            "enName": "Sweep Tosho",
            "jpText": "頭の中に、青い妖精を思い浮かべるの。\r\nそれで、静かに『ムスカリ・カリムス』――",
            "enText": "And picture a blue fairy in your head. \nThen, in a whisper, say \"hyacinth, cyahinth\".",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": -4691388392275287731,
            "blockIdx": 5
        },
        {
            "jpName": "ゼンノロブロイ",
            "enName": "Zenno Rob Roy",
            "jpText": "ああっ！",
            "enText": "Oh!",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 2114011967635166661,
            "blockIdx": 6
        },
        {
            "jpName": "ゼンノロブロイ",
            "enName": "Zenno Rob Roy",
            "jpText": "そ、それって『魔法使いアオの大冒険』に\r\n出てくる魔法じゃないですか……！？",
            "enText": "That's the spell from Ao's Magical \nAdventures,  isn't it?!",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": 5021502948564036012,
            "blockIdx": 7
        },
        {
            "jpName": "ゼンノロブロイ",
            "enName": "Zenno Rob Roy",
            "jpText": "『ムスカリ・カリムス・ムスカリスマ』……\r\nそして目を開けて、指で星を描くんですよね？",
            "enText": "\"Hyacinth, cyahinth, hyacinthia.\" \nThen you open your eyes and trace \na star with your finger, right?",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": 8868562372137888751,
            "blockIdx": 8
        },
        {
            "jpName": "ライスシャワー",
            "enName": "Rice Shower",
            "jpText": "あ、ライスもその本、読んだことあるよ……！\r\n星を書いて……お願いごとをするんだっけ？",
            "enText": "Oh, I've read that book too! You draw a star, \nthen… make a wish, was it?",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": -7101258683157063334,
            "blockIdx": 9
        },
        {
            "jpName": "ゼンノロブロイ",
            "enName": "Zenno Rob Roy",
            "jpText": "そうです、そうです！",
            "enText": "Yes, that's it!",
            "nextBlock": 11,
            "voiceIdx": 9,
            "pathId": -6865191868895304841,
            "blockIdx": 10
        },
        {
            "jpName": "スイープトウショウ",
            "enName": "Sweep Tosho",
            "jpText": "ちょ、ちょっと！\r\n先にぜんぶ言わないでよっ！",
            "enText": "H-Hey! Don't spoil it!",
            "nextBlock": -1,
            "voiceIdx": 10,
            "pathId": 1358773445413645092,
            "blockIdx": 11
        }
