            "blockIdx": 4
        },
        {
            "jpName": "ヒシアケボノ",
            "enName": "Hishi Akebono",
            "jpText": "ありがと～っ！　たくさんお祝いして\r\nもらったし、また大きくなれるかも～。",
            "enText": "You're the best! With all the birthday wishes \nI've gotten, maybe I'll grow even bigger.",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": 4997270113188248818,
            "blockIdx": 5
        },
        {
            "jpName": "マヤノトップガン",
            "enName": "Mayano Top Gun",
            "jpText": "いいな～。マヤも早くボーノちゃんみたいに\r\n大人っぽくなりた～い！",
            "enText": "Must be nice. I wish I wasn't taking so long \nto be all grown-up like you are!",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 5619768062430481554,
            "blockIdx": 6
        },
        {
            "jpName": "マーベラスサンデー",
            "enName": "Marvelous Sunday",
            "jpText": "うんうんっ。アケボノみたいになれたら、\r\nそれはとーってもマーベラスだね☆",
            "enText": "Same here! If I could be like you, that would \nbe super marvelous☆",
