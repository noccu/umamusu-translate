                }
            ],
            "pathId": 3402689495919303851,
            "blockIdx": 27
        },
        {
            "jpName": "",
            "enName": "",
            "jpText": "心を決めて、比較的大人しそうなエリマキトカゲに\n手を伸ばした――瞬間、エリマキが広がった！",
            "enText": "Steeling my resolve, I reached out towards a Frilled Lizard \nthat seemed really docile――and instantly its frills flared out!",
            "nextBlock": 29,
            "origClipLength": 103,
            "voiceIdx": -1,
            "choices": [
                {
