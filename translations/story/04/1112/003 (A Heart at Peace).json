            "pathId": -7939737324780092822,
            "blockIdx": 25
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "どうしたの？　根でも張っちゃった？\nそんな入り口で固まってないで、もっと近くで見てみなさいよ♪",
            "enText": "What's wrong? Putting down roots? \nDon't just stand in the entrance, come and get a closer look♪",
            "nextBlock": 27,
            "origClipLength": 248,
            "voiceIdx": 19,
            "choices": [
                {
                    "jpText": "いや……ここから見守ってるよ！",
                    "enText": "No……I can see just fine from here!",
                    "nextBlock": 27
                }
