            "nextBlock": 21,
            "origClipLength": 207,
            "voiceIdx": 12,
            "choices": [
                {
                    "jpText": "呼吸も止まりがちだ……限界が近いんだよ",
                    "enText": "You're reaching your limit……",
                    "nextBlock": 21
                },
                {
                    "jpText": "呼吸も止まりがちだし……限界が近いんだよ",
                    "enText": "You're reaching your limit……",
