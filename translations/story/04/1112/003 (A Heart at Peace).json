                }
            ],
            "pathId": 1172564677848591835,
            "blockIdx": 23
        },
        {
            "jpName": "",
            "enName": "",
            "jpText": "カフェに着くなり、デアリングハートは目を輝かせて、\n店内中の爬虫類を愛でていく。",
            "enText": "As soon as we arrived at the cafe, Daring Heart's eyes lit up. \nShe went around admiring every reptile in the shop.",
            "nextBlock": 25,
            "origClipLength": 97,
            "voiceIdx": -1,
            "animData": [
                {
                    "origLen": 60,
                    "pathId": 562495506838583347
                },
                {
                    "origLen": 13,
                    "pathId": 4085574042338229764
                },
