    "text": [
        {
            "jpName": "タマモクロス",
            "enName": "Tamamo Cross",
            "jpText": "なあ、オグリ……\r\nいい加減、折れたらどうや……。",
            "enText": "Hey, Oguri. Don'tcha think it's\nabout time ya folded?",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": -1507897144200018987,
            "blockIdx": 1
        },
        {
            "jpName": "オグリキャップ",
            "enName": "Oguri Cap",
            "jpText": "私は、決して諦めない……！",
            "enText": "I absolutely will not give in…!",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": -6835611830421872954,
            "blockIdx": 2
        },
        {
            "jpName": "タマモクロス",
            "enName": "Tamamo Cross",
            "jpText": "ふっ。\r\nほな、続けよか……。",
            "enText": "Hmph. Well, neither will I…",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": 1982274646683984232,
            "blockIdx": 3
        },
        {
            "jpName": "タマモクロス",
            "enName": "Tamamo Cross",
            "jpText": "イカ焼きいうたら粉もんやろっ！！",
            "enText": "<i>Ikayaki</i> is squid fried in batter!!",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": -7699447201718305719,
            "blockIdx": 4
        },
        {
            "jpName": "オグリキャップ",
            "enName": "Oguri Cap",
            "jpText": "イカ焼きは、\r\nイカをそのまま焼いたものだろう！",
            "enText": "<i>Ikayaki</i> is just plain grilled squid!",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": 5998793595202050245,
            "blockIdx": 5
        },
        {
            "jpName": "タマモクロス",
            "enName": "Tamamo Cross",
            "jpText": "なんでわからんのや？\r\n丸のまま焼いとんのやから、それは姿焼きや！",
            "enText": "What part aren'tcha understandin'?\nWhen you just grill the whole thing plain,\nit's called <i>sugatayaki</i>!",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 267063833648458677,
            "blockIdx": 6
        },
        {
            "jpName": "オグリキャップ",
            "enName": "Oguri Cap",
            "jpText": "それは――！",
            "enText": "But…!",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": -3787983729405413462,
            "blockIdx": 7
        },
        {
            "jpName": "タマモクロス",
            "enName": "Tamamo Cross",
            "jpText": "はんっ！　どや？　ウチの完璧な\r\nイカ焼き論は！　ぐうの音も出えへんやろ！",
            "enText": "Hah! See? You can't argue with my perfect\nsquid logic, so eat your words!",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": 2416956453807827086,
            "blockIdx": 8
        },
        {
            "jpName": "オグリキャップ",
            "enName": "Oguri Cap",
            "jpText": "（グゥゥゥ……）",
            "enText": "(<i>Gurgle…</i>)",
            "nextBlock": 10,
            "voiceIdx": -1,
            "pathId": -6461907731362901760,
            "blockIdx": 9
        },
        {
            "jpName": "タマモクロス",
            "enName": "Tamamo Cross",
            "jpText": "出た！？　って腹の音やないかい！！",
            "enText": "Huh?! I didn't mean literally!!",
            "nextBlock": 11,
            "voiceIdx": 8,
            "pathId": -2636398927783134019,
            "blockIdx": 10
        },
        {
            "jpName": "オグリキャップ",
            "enName": "Oguri Cap",
            "jpText": "すまない。イカ焼きの話をしていると、\r\nお腹が空いてしまってな……。",
            "enText": "My apologies. All this talk of eating and squid\nmade my stomach grumble…",
            "nextBlock": 12,
            "voiceIdx": 9,
            "pathId": -6970800231175062492,
            "blockIdx": 11
        },
        {
            "jpName": "タマモクロス",
            "enName": "Tamamo Cross",
            "jpText": "はぁ……まあ、ええわ。一時休戦や。\r\nとりあえず、カフェテリア行こか……。",
            "enText": "Eh… fine, whatever. Let's drop this for now.\nWanna go to the cafeteria?",
            "nextBlock": -1,
            "voiceIdx": 10,
            "pathId": 5957592652408816949,
            "blockIdx": 12
        }
