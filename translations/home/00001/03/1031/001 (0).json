        {
            "jpName": "ダイタクヘリオス",
            "enName": "Daitaku Helios",
            "jpText": "アイネス見つけたっ！　ウェ～～イ！！",
            "enText": "Found an Ines! Waheeey!!",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": 332075690708173262,
            "blockIdx": 1
        },
        {
            "jpName": "メジロパーマー",
            "enName": "Mejiro Palmer",
            "jpText": "ウェ～～イ！　誕生日おめでとう、アイネス！",
            "enText": "Waheeey! Happy birthday, Ines!",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": -4974124485670789373,
            "blockIdx": 2
        },
        {
            "jpName": "アイネスフウジン",
            "enName": "Ines Fujin",
            "jpText": "うぇ……？　あ、ありがとうなの。",
            "enText": "Wahuh? Th-Thank you.",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": 6548823461861243922,
            "blockIdx": 3
        },
        {
            "jpName": "ダイタクヘリオス",
            "enName": "Daitaku Helios",
            "jpText": "ちょ聞いて！　今日ってウチも誕生日なんよ！\n逃げ友でおな誕とか、超ヤバたんっしょ！",
            "enText": "Yo, get this — today's my birthday too! \nThat makes us outrunner twins and bday \ntwins — how cool is that?",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": -4626848811010417264,
            "blockIdx": 4
        },
        {
            "jpName": "メジロパーマー",
            "enName": "Mejiro Palmer",
            "jpText": "せっかくだから、一緒にお祝いしようって\nアイネスを探してたんだ。",
            "enText": "We thought we might as well celebrate \ntogether, so we went looking for ya.",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": -6738599352998125218,
            "blockIdx": 5
        },
        {
            "jpName": "アイネスフウジン",
            "enName": "Ines Fujin",
            "jpText": "そうなんだ。いつもバイトしてばっかだから、\r\nこうしてみんなと盛り上がるのは楽しいの！",
            "enText": "Gotcha. I'm always busy with my part-time \njobs, so I appreciate the chance to have \nsome fun with y'all!",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 8487319461891999815,
            "blockIdx": 6
        },
        {
            "jpName": "ダイタクヘリオス",
            "enName": "Daitaku Helios",
            "jpText": "それなっ！　やっぱ群れてなんぼっしょ！\n3人でバイブス上げてこ！　フーッ！",
            "enText": "For real, everything's more hype together! \nLet's get some good vibes going! Woo!",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": -5821497339369493726,
            "blockIdx": 7
        },
        {
            "jpName": "アイネスフウジン",
            "enName": "Ines Fujin",
            "jpText": "ふ……フーッ！",
            "enText": "W-Woo!",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": 4767210171516005860,
            "blockIdx": 8
        },
        {
            "jpName": "ダイタクヘリオス",
            "enName": "Daitaku Helios",
            "jpText": "いーねぇ、ノッてるじゃん！\nこのままひと晩盛り上がっていくよー！",
            "enText": "That's it, now you're vibing! Now we gotta \nkeep the energy up all night!",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": 6091580727621063542,
            "blockIdx": 9
        },
        {
            "jpName": "ダイタクヘリオス",
            "enName": "Daitaku Helios",
            "jpText": "常識、遠慮、そなもん爆逃げ♪\nウチらはおな誕、ウチらが主役～♪",
            "enText": "Common sense, what's that? Tonight is our \ngetaway♪ 'Cause we the birthday twins, \nthe life of the partaaay!♪",
            "nextBlock": 11,
            "voiceIdx": 9,
            "pathId": 552623653970371952,
            "blockIdx": 10
        },
        {
            "jpName": "メジロパーマー",
            "enName": "Mejiro Palmer",
            "jpText": "はい、アイネスもリズムに乗って～！",
            "enText": "All right! C'mon Ines, ride the rhythm!",
            "nextBlock": 12,
            "voiceIdx": 10,
            "pathId": 2892511337326102671,
            "blockIdx": 11
        },
        {
            "jpName": "アイネスフウジン",
            "enName": "Ines Fujin",
            "jpText": "（もしかしたら、バイト以上に大変なことに\r\n足を踏み入れたかもしれないの……）",
            "enText": "(Is it just me… or did I just get dragged \ninto something even more demanding \nthan work…)",
