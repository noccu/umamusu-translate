        {
            "jpName": "サムソンビッグ",
            "enName": "Samson Big",
            "jpText": "この木箱の山、邪魔だよね。\nまとめて押して、あっちにやっちゃおう！",
            "enText": "This stack of crates is really in the way. \nBetter shove 'em all somewhere else!",
            "nextBlock": 9,
            "origClipLength": 170,
            "voiceIdx": 7,
            "animData": [
                {
                    "origLen": 14,
                    "pathId": -7696652294679552758
