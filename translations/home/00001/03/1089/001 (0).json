    "text": [
        {
            "jpName": "キタサンブラック",
            "enName": "Kitasan Black",
            "jpText": "ハッピー♪　ハッピーバースデー♪\nシュヴァルちゃん～♪",
            "enText": "Happy, happy birthday, Cheval!♪",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": 2414982180906740791,
            "blockIdx": 1
        },
        {
            "jpName": "シュヴァルグラン",
            "enName": "Cheval Grand",
            "jpText": "！？\nあ、あの……？",
            "enText": "Huh?! U-Um…",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": -5908430796820080882,
            "blockIdx": 2
        },
        {
            "jpName": "キタサンブラック",
            "enName": "Kitasan Black",
            "jpText": "シュヴァルちゃん、お誕生日おめでとう！\nあたしとダイヤちゃんから、\nオリジナルソングのプレゼントだよ♪",
            "enText": "Cheval, happy birthday! Diamond and I have \nan original song to present to you♪",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": -3032209755533269913,
            "blockIdx": 3
        },
        {
            "jpName": "サトノダイヤモンド",
            "enName": "Satono Diamond",
            "jpText": "シュヴァルさんのお姉さまと妹さんからも、\nめいっぱいお祝いするよう\n託されていますので！",
            "enText": "Your sisters entrusted us with the important \ntask of throwing a big celebration for you!",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": -892876630736291763,
            "blockIdx": 4
        },
        {
            "jpName": "サトノダイヤモンド",
            "enName": "Satono Diamond",
            "jpText": "受け取ってくださいっ。\n……シュヴァルさんは、とっても真面目♪",
            "enText": "So, I hope you enjoy. \n<i>…Cheval is always super serious♪</i>",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": 1435765366248161448,
            "blockIdx": 5
        },
        {
            "jpName": "サトノダイヤモンド",
            "enName": "Satono Diamond",
            "jpText": "いつも背筋を伸ばして、授業を聞いて♪\nノートも綺麗で、先生も褒めていらした！",
            "enText": "<i>Every day in class, her posture's fabulous♪ \nHer notes are so neat, the teacher praises \nher on repeat♪</i>",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 3846120223639074359,
            "blockIdx": 6
        },
        {
            "jpName": "シュヴァルグラン",
            "enName": "Cheval Grand",
            "jpText": "へっ……！\nちょ……！",
            "enText": "H-Hey! Wh-What are you…!",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": -932095032208659512,
            "blockIdx": 7
        },
        {
            "jpName": "キタサンブラック",
            "enName": "Kitasan Black",
            "jpText": "お掃除もとってもまじめ♪\n隅っこまでしっかり床を磨いてるの、\nみんな見てるよ！",
            "enText": "<i>At cleaning time, she's super serious too♪ \nShe cleans every corner, every spot and \nspeck on the floor, so it looks brand new♪</i>",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": -4725239506047790796,
            "blockIdx": 8
        },
        {
            "jpName": "サトノダイヤモンド",
            "enName": "Satono Diamond",
            "jpText": "移動教室も最後まで残って♪\n忘れ物がないかこっそり見てくれてます！\n優しくて、頭もよくて、素晴らしい――",
            "enText": "<i>And when we move classrooms, she's \nthe last one there♪ Making sure nobody's \nleft anything behind! She's delightful, \nand so very smart, and kind♪</i>",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": -4322301969688699803,
            "blockIdx": 9
        },
        {
            "jpName": "シュヴァルグラン",
            "enName": "Cheval Grand",
            "jpText": "……～～～～っ！！\nわ、わあああああ～～～～……！",
            "enText": "……Ahhhh!",
            "nextBlock": 11,
            "voiceIdx": 9,
            "pathId": 7018607039097465992,
            "blockIdx": 10
        },
        {
            "jpName": "シュヴァルグラン",
            "enName": "Cheval Grand",
            "jpText": "も、もういい！　もうこれ以上は……！\n……ば、爆発しちゃうから！！",
            "enText": "E-Enough! I can't take any more of this! \nI-I'm going to explode!!",
            "nextBlock": 12,
            "voiceIdx": 10,
            "pathId": 92390452554881013,
            "blockIdx": 11
        },
        {
            "jpName": "シュヴァルグラン",
            "enName": "Cheval Grand",
            "jpText": "……でも、ありがとう。\nちゃんと、見ていてくれて。",
            "enText": "But… thanks for noticing.",
            "nextBlock": -1,
            "voiceIdx": 11,
            "pathId": 2535672428060194318,
            "blockIdx": 12
        }
    ],
