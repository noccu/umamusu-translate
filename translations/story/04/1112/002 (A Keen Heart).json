            "blockIdx": 17
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "――…………っ、くぅ……っ！　まだ――……！",
            "enText": "――…………Kuu……! Not yet――……!",
