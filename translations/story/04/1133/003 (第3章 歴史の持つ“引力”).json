            "pathId": 4943301045830458751,
            "blockIdx": 34
        },
        {
            "jpName": "クロノジェネシス",
            "enName": "Chrono Genesis",
            "jpText": "す、すみませんっ……！　とにかく自由に走ろうと考えていたら、\nいつの間にか、こんな……うう……。",
            "enText": "I-I'm so sorry…! I was so focused on just running freely that before I knew it, I ended up like this… ugh…",
            "nextBlock": 36,
            "origClipLength": 323,
            "voiceIdx": 27,
            "animData": [
                {
                    "origLen": 203,
                    "pathId": 7066462049060341304
                },
