    "text": [
        {
            "jpName": "スイープトウショウ",
            "enName": "Sweep Tosho",
            "jpText": "さっきからジロジロこっち見て、\r\nこのスイーピーになんか用っ？",
            "enText": "You've been staring at me for a while now.\nThere something you need from the great\nSweepy?",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": 5473603167636855248,
            "blockIdx": 1
        },
        {
            "jpName": "カレンチャン",
            "enName": "Curren Chan",
            "jpText": "んーと、カレンに魔法少女の道具とか\r\n衣装を貸してほしいんだ～♪",
            "enText": "Um, well, I was wondering if you'd let me\nborrow your magical girl clothes and stuff♪",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": 9087741568403045971,
            "blockIdx": 2
        },
        {
            "jpName": "カレンチャン",
            "enName": "Curren Chan",
            "jpText": "カレン、サイコーに映える\r\nカワイイ魔法少女になりたいのっ！",
            "enText": "I want to be a cute magical girl.\nThat'd be <i>so</i> grammable!",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": -577038945756578684,
            "blockIdx": 3
        },
        {
            "jpName": "スイープトウショウ",
            "enName": "Sweep Tosho",
            "jpText": "仲間が増えるのは大歓迎だけど、なんで今更？\r\nもっと早く言えばよかったじゃない。",
            "enText": "It'd be nice to have another magical girl\naround, but why now of all times?\nCouldn't you have said something earlier?",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": -9211980264913180007,
            "blockIdx": 4
        },
        {
            "jpName": "カレンチャン",
            "enName": "Curren Chan",
            "jpText": "今までは……どうしても\r\nお願いする勇気が出なかったんだ……。",
            "enText": "Well, I would have asked sooner… but I just\ncouldn't work up the courage…",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": 5729964801743901200,
            "blockIdx": 5
        },
        {
            "jpName": "カレンチャン",
            "enName": "Curren Chan",
            "jpText": "だって、スイーピーは……\r\nカレンにとって憧れの魔法少女だからっ！",
            "enText": "I mean, you're the one and only Sweepy…\nI've admired your magicalness for so long!",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 4087390459774845330,
            "blockIdx": 6
        },
        {
            "jpName": "スイープトウショウ",
            "enName": "Sweep Tosho",
            "jpText": "憧れ……？",
            "enText": "You admire me…?",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": -2476058475209785431,
            "blockIdx": 7
        },
        {
            "jpName": "カレンチャン",
            "enName": "Curren Chan",
            "jpText": "うんっ！　ダメ……かな？\r\nうる、うる。",
            "enText": "Yep! Oh, you don't… mind, do you?\nSniffy-sniff…",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": 3089000942010884056,
            "blockIdx": 8
        },
        {
            "jpName": "スイープトウショウ",
            "enName": "Sweep Tosho",
            "jpText": "……べ、別に？\r\nしょうがないから貸してあげてもいいけど？",
            "enText": "W-Well, I guess it's fine! Look, I'll lend you\nsome clothes already, okay?",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": 6534287607887071632,
            "blockIdx": 9
        },
        {
            "jpName": "カレンチャン",
            "enName": "Curren Chan",
            "jpText": "やった～！　『#カレン　#魔法少女デビュー\r\n#カワイイ　#は　#最強の魔法♪\n#最強魔法少女☆カレンチャン』っと♪",
            "enText": "Yaaay! \" #UltimateMagicalGirlCurren\"\n#MagicalGirlDebut #CutenessIsMagic♪\n…There!♪",
            "nextBlock": 11,
            "voiceIdx": 9,
            "pathId": 4859519201263864511,
            "blockIdx": 10
        },
        {
            "jpName": "スイープトウショウ",
            "enName": "Sweep Tosho",
            "jpText": "いや、気ぃ早すぎでしょ！？",
            "enText": "You're <i>already</i> posting about it?!",
