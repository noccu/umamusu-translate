            "pathId": -1378655523158147413,
            "blockIdx": 30
        },
        {
            "jpName": "クロノジェネシス",
            "enName": "Chrono Genesis",
            "jpText": "な、なるほど……自由に、ですね。\nはい、意識してみます……！",
            "enText": "I-I see…… so, run freely. \nRight, I'll make sure to keep that in mind…!",
            "nextBlock": 32,
            "origClipLength": 246,
            "voiceIdx": 24,
            "animData": [
                {
                    "origLen": 50,
                    "pathId": -5252810508491501357
                },
                {
                    "origLen": 20,
                    "pathId": -8946089663654451031
                }
            ],
            "pathId": 5893721845704427582,
            "blockIdx": 31
        },
        {
            "jpName": "クロノジェネシス",
            "enName": "Chrono Genesis",
            "jpText": "（歴史を参照しない、私らしい走り……\n自由に……なにも考えずに――）",
            "enText": "(Running my own way, without looking back at the past… \nFreely… without thinking about anything—)",
            "nextBlock": 33,
            "origClipLength": 240,
            "voiceIdx": 25,
            "animData": [
                {
                    "origLen": 15,
