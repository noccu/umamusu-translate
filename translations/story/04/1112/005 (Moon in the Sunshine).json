            "pathId": 3538771637051154248,
            "blockIdx": 18
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "フフッ！\n場所が変わるだけで、結構楽しいでしょ？",
            "enText": "Fufuu! Just by changing the location, \nit's still pretty fun, right?",
            "nextBlock": 20,
            "origClipLength": 145,
            "voiceIdx": 14,
            "animData": [
                {
                    "origLen": 170,
                    "pathId": -4157605180823386169
                },
                {
                    "origLen": 20,
                    "pathId": 7216888217757380017
                }
            ],
            "pathId": -2139774260977544977,
            "blockIdx": 19
        },
        {
            "jpName": "ハートの友人B",
            "enName": "Heart's Friend B",
            "jpText": "――じゃあ私たち先に帰ってるね。\nトレーナーさん、今日はありがとうございました！",
            "enText": "――Then, we'll be heading back first. \nTrainer-san, thanks for today!",
            "nextBlock": 21,
            "origClipLength": 172,
            "voiceIdx": 15,
            "animData": [
                {
                    "origLen": 219,
                    "pathId": -1595014944469501659
                },
                {
                    "origLen": 30,
                    "pathId": 4090041577902142376
                }
            ],
            "pathId": -4600457726732862261,
            "blockIdx": 20
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "……ふぅ～。\n明日が休養日だからって、メニュー詰めすぎたわね。",
            "enText": "……Phew～. Even though tomorrow's a rest day, \nwe still put too much in the menu, huh?",
            "nextBlock": 22,
            "origClipLength": 232,
            "voiceIdx": 16,
            "choices": [
                {
                    "jpText": "ああ、ゆっくり休んで",
                    "enText": "Yeah, make sure to get a good rest",
                    "nextBlock": 22
                },
                {
                    "jpText": "うん、ゆっくり休んで",
                    "enText": "Yeah, make sure to get a good rest",
                    "nextBlock": 22
                }
            ],
            "animData": [
                {
                    "origLen": 119,
                    "pathId": 7993810730804990539
                },
                {
                    "origLen": 20,
                    "pathId": -8738971366943015872
                }
