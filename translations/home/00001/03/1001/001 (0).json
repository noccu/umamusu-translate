    "text": [
        {
            "jpName": "グラスワンダー",
            "enName": "Grass Wonder",
            "jpText": "スペちゃん、\r\nお誕生日おめでとうございます。",
            "enText": "Spe, happy birthday.",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": -879645856231693626,
            "blockIdx": 1
        },
        {
            "jpName": "エルコンドルパサー",
            "enName": "El Condor Pasa",
            "jpText": "誕生、感動、おめでとうデェェェス！\nプレゼントもありますよっ。",
            "enText": "We wish you a spectacular, magnificent, very\nhappy birthday! We got you a present too!",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": 3138870203754358116,
            "blockIdx": 2
        },
        {
            "jpName": "スペシャルウィーク",
            "enName": "Special Week",
            "jpText": "わぁ……！\nグラスちゃん、エルちゃん、ありがとう～！",
            "enText": "Ahh…! Grass, El, thank you!",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": -1059897777856813284,
            "blockIdx": 3
        },
        {
            "jpName": "スペシャルウィーク",
            "enName": "Special Week",
            "jpText": "みんなからお祝いしてもらって、\nプレゼントまでもらえるなんて……！",
            "enText": "I get to have birthday wishes \n<i>and</i> birthday presents?",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": 8062383495689561252,
            "blockIdx": 4
        },
        {
            "jpName": "スペシャルウィーク",
            "enName": "Special Week",
            "jpText": "私……本当に本当に、嬉しくて……！",
            "enText": "I… I'm just so happy right now!",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": 628055100842214265,
            "blockIdx": 5
        },
        {
            "jpName": "グラスワンダー",
            "enName": "Grass Wonder",
            "jpText": "ふふ。最近、発売したばかりの\r\nにんじんスコーンなんですけど、\nとっても美味しいんですよ～。",
            "enText": "Hehe. We got you one of those carrot scones \nthey just came out with. It's very tasty.",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": -2351101637633143697,
            "blockIdx": 6
        },
        {
            "jpName": "エルコンドルパサー",
            "enName": "El Condor Pasa",
            "jpText": "フッフッフッ。朝から並んで買ってきました！\r\n一生、大事にしてください！",
            "enText": "Hehehe… We lined up early in the morning \nto get it! Treasure it for life!",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": 3295238992700610500,
            "blockIdx": 7
        },
        {
            "jpName": "スペシャルウィーク",
            "enName": "Special Week",
            "jpText": "わかった……！　食べたいけど、\n一生、大切にするね！！",
            "enText": "You bet! I do want to eat it, \nbut I'll treasure it for life!",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": -542881758964320864,
            "blockIdx": 8
        },
        {
            "jpName": "エルコンドルパサー",
            "enName": "El Condor Pasa",
            "jpText": "冗談デース！！　食べてくださいッ。",
            "enText": "Th-That was a joke! Please eat it!",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": 5296987545288219160,
            "blockIdx": 9
        },
        {
            "jpName": "グラスワンダー",
            "enName": "Grass Wonder",
            "jpText": "……焦らなくても、スペちゃんは\nきっと我慢できませんよ、エル。",
            "enText": "…No need to panic, El — I doubt Spe would \nbe able to resist anyway.",
            "nextBlock": -1,
            "voiceIdx": 9,
            "pathId": -8942758463317561740,
            "blockIdx": 10
        }
    ],
