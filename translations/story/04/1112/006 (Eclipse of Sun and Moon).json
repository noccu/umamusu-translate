        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "『ベスト・エージェント・ルック・コンテスト』。\nようは『変装コンテスト』ね。",
            "enText": "『Best Agent-Look Contest』. Like a 『Disguise Contest』",
            "nextBlock": 17,
