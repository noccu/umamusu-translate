                }
            ],
            "pathId": -7132983673603089769,
            "blockIdx": 28
        },
        {
            "jpName": "スペシャルウィーク",
            "enName": "Special Week",
            "jpText": "『すっごく仲良しですよね！　よくふたりで、\nわっはっはって笑ってますから！』",
            "enText": "\"They're really great friends, aren't they! \nBecause I see the two of them going \n'Wahaha' and smiling together a lot!\"",
            "nextBlock": 30,
            "origClipLength": 94,
            "voiceIdx": 48,
            "animData": [
                {
                    "origLen": 105,
                    "pathId": -1610146917178658191
                },
