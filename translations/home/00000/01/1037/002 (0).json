        {
            "jpName": "エイシンフラッシュ",
            "enName": "Eishin Flash",
            "jpText": "トレーナーさん……？",
            "enText": "Trainer…?",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": 7314104548171528160,
            "blockIdx": 1
        },
        {
            "jpName": "エイシンフラッシュ",
            "enName": "Eishin Flash",
            "jpText": "この時間、ミーティングの予定は\r\n入っていなかったと思いますが。",
            "enText": "I don't believe we have a meeting scheduled \nfor this time slot, do we?",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": -5924664204282846528,
            "blockIdx": 2
        },
        {
            "jpName": "エイシンフラッシュ",
            "enName": "Eishin Flash",
            "jpText": "雑談、ですか。\r\nいえ、嫌という訳では。",
            "enText": "A chat? No, I don't mind. It's just…",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": 6145775029727247150,
            "blockIdx": 3
        },
        {
            "jpName": "エイシンフラッシュ",
            "enName": "Eishin Flash",
            "jpText": "予定にない会話は不慣れなものですから。\r\n次は、雑談も予定に組み込んでおきます。",
            "enText": "I am unaccustomed to conversation outside \nof scheduled time. My apologies. I'll be sure \nto account for chats in my schedule going \nforward.",
            "nextBlock": -1,
            "voiceIdx": 3,
            "pathId": -4491552032037708313,
            "blockIdx": 4
        }
