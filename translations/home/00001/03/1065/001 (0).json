    "text": [
        {
            "jpName": "メジロマックイーン",
            "enName": "Mejiro McQueen",
            "jpText": "ヘリオスさん、\nお誕生日おめでとうございます。",
            "enText": "Helios, happy birthday.",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": 1761129685965407691,
            "blockIdx": 1
        },
        {
            "jpName": "メジロアルダン",
            "enName": "Mejiro Ardan",
            "jpText": "おめでとうございます。",
            "enText": "Happy birthday.",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": -962377045456750547,
            "blockIdx": 2
        },
        {
            "jpName": "ダイタクヘリオス",
            "enName": "Daitaku Helios",
            "jpText": "うっは！？　メジロ家でお祝いとかマジヤバ！\nこれが誕生日ボーナスってやつ！？",
            "enText": "Whoa! Birthday wishes from the Mejiros?! \nIs this what they call a birthday bonus?!",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": -3227410911214458867,
            "blockIdx": 3
        },
        {
            "jpName": "メジロマックイーン",
            "enName": "Mejiro McQueen",
            "jpText": "パーマーから話を聞きましたの。\nぜひとも友人を祝ってほしいと。",
            "enText": "Thank Palmer. She asked that we celebrate \nher friend's special day.",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": 11207645815890753,
            "blockIdx": 4
        },
        {
            "jpName": "メジロアルダン",
            "enName": "Mejiro Ardan",
            "jpText": "パーマーも、ヘリオスさんと出会えたことで\n多くの学びを得たと言っていました。",
            "enText": "Palmer was telling us about how much \nshe's learned since meeting you.",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": 8284007126366077066,
            "blockIdx": 5
        },
        {
            "jpName": "メジロアルダン",
            "enName": "Mejiro Ardan",
            "jpText": "これからもパーマー共々、\nよろしくお願いいたします。",
            "enText": "We hope you'll continue to be good friends \nwith our Palmer — and us.",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": -3122797674650649196,
            "blockIdx": 6
        },
        {
            "jpName": "ダイタクヘリオス",
            "enName": "Daitaku Helios",
            "jpText": "パーマー激エモ！\n出会って嬉しいのはウチも同じだし！",
            "enText": "OMG Palmer really is doing the most! \nBut I'm so glad I met her too!",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": 2463552713914617506,
            "blockIdx": 7
        },
        {
            "jpName": "ダイタクヘリオス",
            "enName": "Daitaku Helios",
            "jpText": "アルダン先輩もマックイーンも\r\nとりまリア友ってことでよろたんウェーイ！",
            "enText": "And you guys too, we besties now — waheeey!",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": 375775387352638863,
            "blockIdx": 8
        },
        {
            "jpName": "メジロアルダン",
            "enName": "Mejiro Ardan",
            "jpText": "ふふっ、本当に賑やかな方ですね。\nうぇ～～い。",
            "enText": "Hehe. I'm jealous of your energy. Waheeey.",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": -2631387324860667224,
            "blockIdx": 9
        },
        {
            "jpName": "ダイタクヘリオス",
            "enName": "Daitaku Helios",
            "jpText": "ウェーイ！　マックイーンもウェーイ！",
            "enText": "Waheeey! You too, McQueen — waheeey!",
            "nextBlock": 11,
            "voiceIdx": 9,
            "pathId": 5753296150945733303,
            "blockIdx": 10
        },
        {
            "jpName": "メジロマックイーン",
            "enName": "Mejiro McQueen",
            "jpText": "……じわじわとメジロ家のイメージが\n崩れていく気がしますわ……。",
            "enText": "I feel the Mejiros' dignified image \ncrumbling as we speak…",
            "nextBlock": -1,
            "voiceIdx": 10,
            "pathId": -232424874780469281,
            "blockIdx": 11
        }
    ],
