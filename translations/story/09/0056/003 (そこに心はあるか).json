        {
            "jpName": "フェノーメノ",
            "enName": "Fenomeno",
            "jpText": "ちょ、ウララさん！？　壁に落書きをしてはいけません！",
            "enText": "U-Urara-san!? You shouldn't vandalize the wall!",
            "nextBlock": 14,
            "origClipLength": 112,
            "voiceIdx": 12,
            "animData": [
