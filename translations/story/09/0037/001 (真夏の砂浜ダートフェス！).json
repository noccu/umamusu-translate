            "origClipLength": 185,
            "voiceIdx": 1,
            "pathId": 4699731986004459001,
            "blockIdx": 2
        },
        {
            "jpName": "ワンダーアキュート",
            "enName": "",
            "jpText": "おやまあ元気だこと。\nふふふふっ、どっちもがんばれぇ～♪",
