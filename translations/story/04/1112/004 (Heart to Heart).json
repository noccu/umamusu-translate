            "blockIdx": 20
        },
        {
            "jpName": "シーザリオ",
            "enName": "Cesario",
            "jpText": "フッ――……！！\nハァアアアアアッ――――！！",
            "enText": "Fuu――……!! \nHaaaaaaaa――――!!",
            "nextBlock": 22,
            "origClipLength": 137,
            "voiceIdx": 14,
            "animData": [
                {
                    "origLen": 110,
                    "pathId": 4884898342492882500
                }
            ],
            "pathId": 6167631056785883359,
            "blockIdx": 21
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "（――来たわね。その足音、そのプレッシャー……\nああ、ゾクゾクする……！）",
            "enText": "(――Here they come. Their footsteps, this pressure…… \nAhhh, it makes my heart race……!)",
            "nextBlock": 23,
            "origClipLength": 223,
            "voiceIdx": 15,
            "animData": [
                {
                    "origLen": 243,
                    "pathId": 4709058361721307617
                },
                {
                    "origLen": 26,
                    "pathId": -5952021822826558611
                }
            ],
            "pathId": 2317370807841230170,
            "blockIdx": 22
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "（これが、私の求めていた世界。気高く、泥臭く、\nむき出しのハートでぶつかり合う、heart to heart――！）",
            "enText": "(This is the world I was seeking. Noble, yet gritty. \nHearts laid bare, clashing, heart to heart――!)",
            "nextBlock": 24,
            "origClipLength": 365,
            "voiceIdx": 16,
            "animData": [
                {
                    "origLen": 376,
                    "pathId": -4584354550600546315
                }
            ],
            "pathId": 7403268638361460633,
            "blockIdx": 23
        },
        {
            "jpName": "モノローグ",
            "enName": "",
            "jpText": "デアリングハートは、ここまで無駄な動きを抑えて走っていた。\n――並み居るライバルを、その爆発力で突き放すために！",
            "enText": "Daring Heart had been running while minimizing any \nexcess movement up to this point. ――All to unleash \nher explosive power and leave her rivals behind!",
            "nextBlock": 25,
            "origClipLength": 118,
            "voiceIdx": -1,
            "animData": [
                {
                    "origLen": 140,
                    "pathId": -5535665598220962087
                }
            ],
            "pathId": -4653665896428976059,
            "blockIdx": 24
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "（羽は休めた。ハートは満たされた。\nなら……あとは高く、誰よりも高く飛ぶだけ！）",
            "enText": "(I've rested my wings. My Heart is full. Then…… \nAll that's left is to fly high――higher than anyone else!)",
            "nextBlock": 26,
            "origClipLength": 330,
            "voiceIdx": 17,
            "animData": [
                {
                    "origLen": 374,
                    "pathId": 2509577864034505271
                },
                {
                    "origLen": 20,
                    "pathId": 8284292654097647217
                }
            ],
            "pathId": -4032838085543377372,
            "blockIdx": 25
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "私を見なさい！　目を離さないで！\n今、この瞬間……私が、世界で一番輝くクイーンよ！！",
            "enText": "Just watch me! Don't look away! \nNow, in this moment……I am the Queen that shines brightest of all!!",
            "nextBlock": 27,
            "origClipLength": 342,
            "voiceIdx": 18,
            "animData": [
                {
                    "origLen": 375,
                    "pathId": -4431128672738088941
                }
            ],
            "pathId": -1039089256509962140,
            "blockIdx": 26
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "Go……Daring Heart――ッ！！\nハァアアアアアアアアアッ！！",
            "enText": "Go……Daring Heart――!! \nHaaaaaaaaaaaaaaaaa!!",
            "nextBlock": 28,
            "origClipLength": 242,
            "voiceIdx": 19,
            "animData": [
                {
                    "origLen": 143,
                    "pathId": -659609342676237009
                }
            ],
            "pathId": -266340661523646228,
            "blockIdx": 27
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "……っ、はぁ……っ！\nはぁ……、はぁ……、はぁ……！",
            "enText": "……Haa……! \nHaa……haa……haa……!",
            "nextBlock": 29,
            "origClipLength": 219,
            "voiceIdx": 20,
            "animData": [
                {
                    "origLen": 189,
                    "pathId": 1800210429214272478
                },
                {
                    "origLen": 141,
                    "pathId": -4792144109547958649
                },
                {
                    "origLen": 246,
                    "pathId": -6087465784630725534
                }
            ],
            "pathId": 4213644600563276417,
            "blockIdx": 28
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "――――……くっ！\nかわされた……前を、行かれた――……っ！！",
            "enText": "――――……Kuu! \nThey passed me……got in front of me――……!!",
            "nextBlock": 30,
            "origClipLength": 304,
            "voiceIdx": 21,
            "choices": [
                {
                    "jpText": "ハート！！",
                    "enText": "Heart!!",
                    "nextBlock": 30
                }
            ],
            "animData": [
                {
                    "origLen": 138,
                    "pathId": 5221163816263964269
                },
                {
                    "origLen": 47,
                    "pathId": -462268508449393694
                },
                {
                    "origLen": 315,
                    "pathId": -8100763387789374341
                }
            ],
            "pathId": -1832416208539105013,
            "blockIdx": 29
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "あと少しだった……本当に、あと、少し――……。",
            "enText": "Just a little more……really just a little――……",
            "nextBlock": 31,
            "origClipLength": 223,
            "voiceIdx": 22,
            "choices": [
                {
                    "jpText": "いい走りだったよ……特にラストスパート！",
                    "enText": "It was good……especially the last spurt!",
                    "nextBlock": 31
                }
            ],
            "animData": [
                {
                    "origLen": 70,
                    "pathId": 5288608229632609621
                },
                {
                    "origLen": 290,
                    "pathId": 5037724647768331512
                },
                {
                    "origLen": 293,
                    "pathId": -362182287413636550
                }
            ],
            "pathId": -7287500247802786737,
            "blockIdx": 30
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "でも……どんなに惜しくても負けは、負け。\n私は――勝利に届かなかった。",
