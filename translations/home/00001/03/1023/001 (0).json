    "text": [
        {
            "jpName": "ウイニングチケット",
            "enName": "Winning Ticket",
            "jpText": "ハヤヒデ！　誕・生・日っ、おめでとぉ～っ！",
            "enText": "Hayahide! Happyyy birthdaaay!",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": -3966288378876860990,
            "blockIdx": 1
        },
        {
            "jpName": "ナリタタイシン",
            "enName": "Narita Taishin",
            "jpText": "…………おめでと。",
            "enText": "…Happy birthday.",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": -6886510858064469067,
            "blockIdx": 2
        },
        {
            "jpName": "ビワハヤヒデ",
            "enName": "Biwa Hayahide",
            "jpText": "ふふ、ありがとう2人とも。今年もこうして\n君たちと過ごせて、嬉しい限りだよ。",
            "enText": "Heh, thank you. Getting to spend \nanother birthday with you two is all \nI could ever ask for.",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": 889609699363447599,
            "blockIdx": 3
        },
        {
            "jpName": "ウイニングチケット",
            "enName": "Winning Ticket",
            "jpText": "そういえばハヤヒデって、ブライアンの\r\nお姉ちゃんでもあるけど、アタシたちの\n中でもいちばんお姉ちゃんなんだよね！",
            "enText": "If you think about it, you're Brian's older \nsister, but you're also the older sister \nout of the three of us, too!",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": 8510614724273257810,
            "blockIdx": 4
        },
        {
            "jpName": "ウイニングチケット",
            "enName": "Winning Ticket",
            "jpText": "じゃあじゃあ！！　アタシ今日1日、\nハヤヒデのこと『お姉ちゃん』って呼ぶよっ！",
            "enText": "Oh, I know! For the rest of the day, \nI'm gonna call you \"big sis\"!",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": -7469033877854151702,
            "blockIdx": 5
        },
        {
            "jpName": "ビワハヤヒデ",
            "enName": "Biwa Hayahide",
            "jpText": "……！？",
            "enText": "…?!",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": -6850233933002754647,
            "blockIdx": 6
        },
        {
            "jpName": "ウイニングチケット",
            "enName": "Winning Ticket",
            "jpText": "あっ、ハヤヒデ喜んでる？　喜んでるよね！？\nやったー！　ほらほら、タイシンも！！",
            "enText": "Ah, you like that? You do, don't you? \nWoohoo! C'mon, you do it too, Taishin!",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": -3756592284561810010,
            "blockIdx": 7
        },
        {
            "jpName": "ナリタタイシン",
            "enName": "Narita Taishin",
            "jpText": "は！？　やんないし！",
            "enText": "Huh? Not a chance!",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": -2436582721787086740,
            "blockIdx": 8
        },
        {
            "jpName": "ウイニングチケット",
            "enName": "Winning Ticket",
            "jpText": "なんでぇ～！　お姉ちゃんだとイヤなのっ？\nじゃあアネゴ？　アネキ？　姉上っ！？",
            "enText": "Why nooot? You don't like \"big sis\"? \nWhat about just \"sis\"? \"Big sister\"? \n\"Dearest sister\"?!",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": 2360730707202160321,
            "blockIdx": 9
        },
        {
            "jpName": "ナリタタイシン",
            "enName": "Narita Taishin",
            "jpText": "そういう意味じゃない！！\nだいたい『お姉ちゃん』とか――",
            "enText": "That's not what I mean! \nFirst of all, why would \"big sis\" be ——",
            "nextBlock": 11,
            "voiceIdx": 9,
            "pathId": -4768021015331623868,
            "blockIdx": 10
        },
        {
            "jpName": "ビワハヤヒデ",
            "enName": "Biwa Hayahide",
            "jpText": "…………！！！！",
            "enText": "……!!!",
            "nextBlock": 12,
            "voiceIdx": 10,
            "pathId": 1841530551091668079,
            "blockIdx": 11
        },
        {
            "jpName": "ナリタタイシン",
            "enName": "Narita Taishin",
            "jpText": "～～～ッ、アンタも反応すんな、バカ！",
            "enText": "Stop reacting to it, idiot!",
            "nextBlock": -1,
            "voiceIdx": 11,
            "pathId": 9158854291047271979,
            "blockIdx": 12
        }
    ],
