            "pathId": -2076153375216701039,
            "blockIdx": 8
        },
        {
            "jpName": "ナイスネイチャ",
            "enName": "Nice Nature",
            "jpText": "あはは、もうお腹ペコペコ！　って顔だ？\nちゃちゃっと作るんで、待ってて下さいな～。",
            "enText": "Ahaha, you look ready to inhale the whole\nbowl the moment you get it! Just gimme\na min, alright?",
            "nextBlock": 10,
            "origClipLength": 233,
            "voiceIdx": 7,
            "pathId": -4685654966818509112,
            "blockIdx": 9
        },
        {
            "jpName": "メイショウドトウ",
            "enName": "Meisho Doto",
            "jpText": "す、すみません～……！　え、ええっとぉ……\n今、麺入れましたぁ～……！！",
            "enText": "Oh I-I'm sorryyyy…! Ummmmm…\nAlright! The noodles are in…!!",
            "nextBlock": 11,
            "origClipLength": 208,
            "voiceIdx": 8,
            "pathId": 6579285402280290133,
            "blockIdx": 10
        },
        {
            "jpName": "ファインモーション",
            "enName": "Fine Motion",
            "jpText": "よーし、いくよー……えいっ！　やあっ！",
            "enText": "Alright! Here goes… One! Twooo!",
            "nextBlock": 12,
            "origClipLength": 113,
            "voiceIdx": 9,
            "pathId": -1789445010401005321,
            "blockIdx": 11
        },
        {
            "jpName": "ファインモーション",
            "enName": "Fine Motion",
            "jpText": "美味しくー……なれっ！",
            "enText": "Shake ooouut… the taste!",
            "nextBlock": 13,
            "origClipLength": 75,
            "voiceIdx": 10,
            "pathId": -7756197799553542509,
            "blockIdx": 12
        },
        {
            "jpName": "カルストンライトオ",
            "enName": "Calstone Light O",
            "jpText": "任せろ。ネギネギモヤシネギモヤシ海苔。",
            "enText": "I got this. <i>Onion-onion-sprouts—\nonion-sprouts-seaweed!</i>",
            "nextBlock": 14,
            "origClipLength": 76,
            "voiceIdx": 11,
            "pathId": 5109909810290132042,
            "blockIdx": 13
        },
        {
            "jpName": "ナリタトップロード",
            "enName": "Narita Top Road",
            "jpText": "いいですよ、ライトオちゃん！\n盛り付け、崩れたら私が整えますから、\nどんどん入れちゃって下さいっ！",
            "enText": "Great work, Light O! Don't worry too much\nabout the presentation. I'll fix it up if needed, so keep at it!",
            "nextBlock": 15,
            "origClipLength": 178,
            "voiceIdx": 12,
            "pathId": 8949326277171307366,
            "blockIdx": 14
        },
        {
            "jpName": "ファインモーション",
            "enName": "Fine Motion",
            "jpText": "へいっ、お待ちっ！",
            "enText": "Here you go!",
            "nextBlock": 16,
            "origClipLength": 55,
            "voiceIdx": 13,
            "pathId": 1944418287375780904,
            "blockIdx": 15
        },
        {
            "jpName": "ナレーション",
            "enName": "Narrator",
            "jpText": "――ラーメン。\nそれは、誰しもが愛する国民食。",
            "enText": "Ramen — the beloved comfort food\nof the nation.",
