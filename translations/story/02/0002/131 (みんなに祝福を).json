            "origClipLength": 184,
            "voiceIdx": -1,
            "pathId": -1278484496350784107,
            "blockIdx": 54
        },
        {
            "jpName": "ライスシャワー",
            "enName": "Rice Shower",
            "jpText": "え……？　あ……あ……！？",
            "enText": "Huh? Wh-Wha—?!",
            "nextBlock": 56,
            "origClipLength": 151,
            "voiceIdx": 38,
            "pathId": -1469269497695062566,
            "blockIdx": 55
        },
        {
            "jpName": "実況",
            "enName": "Commentator",
            "jpText": "ものすごい歓声ですっ！！\nスタンドを埋め尽くす観客が、ライスシャワーを称えています！",
            "enText": "The cheers are deafening! The entire stadium is lavishing Rice Shower \nwith praise!",
            "nextBlock": 57,
            "origClipLength": 236,
            "voiceIdx": 39,
            "pathId": -1004690033938774304,
            "blockIdx": 56
        },
        {
            "jpName": "ライスシャワー",
            "enName": "Rice Shower",
            "jpText": "みんなが……みんなが喜んでくれてる……。\n笑ってくれてる……！",
