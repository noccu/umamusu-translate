    "title": "ワルのハートに響かせろ！",
    "enTitle": "Shaking Your Bad Guy Heart!",
    "text": [
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "“ペースよみ”さんから、お返事きてないね……。",
            "enText": "\"Miss Pace Blind\" isn't writing back…",
            "nextBlock": 2,
            "origClipLength": 111,
            "voiceIdx": 0,
            "animData": [
                {
                    "origLen": 206,
                    "pathId": 3469139270447289205
