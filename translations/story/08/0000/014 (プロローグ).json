        {
            "jpName": "ナイスネイチャ",
            "enName": "Nice Nature",
            "jpText": "あいよー。\nよっ、とっ、はっ！",
            "enText": "Coming right up!\nHah, hup, aaand <i>plop</i>!",
            "nextBlock": 9,
            "origClipLength": 100,
            "voiceIdx": 6,
            "animData": [
                {
                    "origLen": 40,
