            "blockIdx": 23
        },
        {
            "jpName": "シンコウウインディ",
            "enName": "Shinko Windy",
            "jpText": "ぴっ！？　たたた、隊長っ！？",
            "enText": "Eek! \nC-C-C-Captain!?",
            "nextBlock": 25,
            "origClipLength": 92,
            "voiceIdx": 23,
            "animData": [
                {
                    "origLen": 93,
                    "pathId": 8076164029568662048
