            "pathId": -2851005213052955560,
            "blockIdx": 35
        },
        {
            "jpName": "モノローグ",
            "enName": "",
            "jpText": "彼女にバッグを渡そうとして、\n開かれたままのスケジュール帳が、目に入った。",
            "enText": "As I grabbed her bag, my eyes fell on \nthe schedule book she had left lying open.",
            "nextBlock": 37,
            "origClipLength": 93,
            "voiceIdx": -1,
            "choices": [
                {
                    "jpText": "（なんだ……これは……）",
                    "enText": "(Wait……this is……)",
                    "nextBlock": 37
                },
                {
                    "jpText": "（なに……これ……）",
                    "enText": "(Wait……this is……)",
