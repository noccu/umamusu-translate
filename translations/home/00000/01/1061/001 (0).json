    "text": [
        {
            "jpName": "キングヘイロー",
            "enName": "King Halo",
            "jpText": "はあ……また連絡が来てる。\nまったく、お母さまったら……。",
            "enText": "<i>Sigh…</i> Another message… \nMust Mother be so persistent?",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": -5190162515927533058,
            "blockIdx": 1
        },
        {
            "jpName": "キングヘイロー",
            "enName": "King Halo",
            "jpText": "何が『心配してる』よ。\n『あなたのため』よ。",
            "enText": "What does she mean she's \"worried\"? Are all\nthese messages \"for my own good\" too?",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": -2099252062367939673,
            "blockIdx": 2
        },
        {
            "jpName": "キングヘイロー",
            "enName": "King Halo",
            "jpText": "……たまには『頑張ってるわね』\nの一言だけでいいじゃない。",
            "enText": "…Can't she just tell me she's proud of me \nand leave it at that?",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": -7100034174600281047,
            "blockIdx": 3
        },
        {
            "jpName": "キングヘイロー",
            "enName": "King Halo",
            "jpText": "って、トレーナー！？\nいつからここにっ！？",
            "enText": "T-Trainer?! When did you get here?!",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": 7535107192425529591,
            "blockIdx": 4
        },
        {
            "jpName": "キングヘイロー",
            "enName": "King Halo",
            "jpText": "んもう！　今見たことは\n忘れなさい！　今すぐに、よ！？",
            "enText": "Ohhh, forget everything you just saw! \nRight this instant!",
            "nextBlock": -1,
            "voiceIdx": 4,
            "pathId": -5040497715512161928,
            "blockIdx": 5
        }
    ],
