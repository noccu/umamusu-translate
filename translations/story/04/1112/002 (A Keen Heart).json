            "pathId": -8818972554396693595,
            "blockIdx": 11
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "I can do this……――まだ、いけるわ……。",
            "enText": "I can do this……――I can keep going……",
