    "text": [
        {
            "jpName": "ダイタクヘリオス",
            "enName": "Daitaku Helios",
            "jpText": "お嬢っっっ！！\nハピバ～～～～！",
            "enText": "Rubaeeee!! Happy biiiirth!",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": -1155184391900892056,
            "blockIdx": 1
        },
        {
            "jpName": "メジロパーマー",
            "enName": "Mejiro Palmer",
            "jpText": "おめでとう、ルビー！\nうぇいうぇ～い！",
            "enText": "Happy birthday, Ruby! Waheeey!",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": 4346861505227614669,
            "blockIdx": 2
        },
        {
            "jpName": "ダイイチルビー",
            "enName": "Daiichi Ruby",
            "jpText": "祝いのお言葉、感謝申し上げます。",
            "enText": "Thank you for the well wishes.",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": 2394632984538506670,
            "blockIdx": 3
        },
        {
            "jpName": "ダイタクヘリオス",
            "enName": "Daitaku Helios",
            "jpText": "！？\nう、うえぇえええええ……！！",
            "enText": "!? <i>WA- WAAAAHHHH</i>!!",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": 8658679560821701146,
            "blockIdx": 4
        },
        {
            "jpName": "メジロパーマー",
            "enName": "Mejiro Palmer",
            "jpText": "ちょ、返事きただけで！？\n早いって！　まだ伝えたいことあるんでしょ？",
            "enText": "J-Just from a \"thank you\"? Keep it together! \nYou still have more to say, don't you?",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": -3515645426381350814,
            "blockIdx": 5
        },
        {
            "jpName": "ダイタクヘリオス",
            "enName": "Daitaku Helios",
            "jpText": "うぅっ……う゛ん゛っ。\nお嬢！　今夜さ、パらん！？\nウチ、いろいろ考えて――",
            "enText": "Ungh… uh-huh… Rubae! Wanna party \ntonight? I put a lot of tho—",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 7978836843930048401,
            "blockIdx": 6
        },
        {
            "jpName": "ダイイチルビー",
            "enName": "Daiichi Ruby",
            "jpText": "申し訳ありませんが、夜は会食があります。\nこの時期は特に予定が入りやすいので、\n事前にご相談いただけますと幸いです。",
            "enText": "I'm terribly sorry, but I have a dinner to \nattend tonight. This time of year tends \nto get rather busy, so I would appreciate it \nif you'd schedule plans ahead of time.",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": -720752562084254715,
            "blockIdx": 7
        },
        {
            "jpName": "ダイタクヘリオス",
            "enName": "Daitaku Helios",
            "jpText": "じゃあ来年の分、今とっちゃう！！\n来年の今日！　ウチにちょーだいっ！\n予約っ！　約束～～！！",
            "enText": "All right, then I call dibs on next year!!\nToday one year from now — all mine, please!\nThere, scheduled! It's a date!!",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": 2356197851668712295,
            "blockIdx": 8
        },
        {
            "jpName": "ダイイチルビー",
            "enName": "Daiichi Ruby",
            "jpText": "……確約はできかねますが、\n執事には伝えます。",
            "enText": "…I cannot make any guarantees, \nbut I'll tell my butler.",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": -6383523818660877591,
            "blockIdx": 9
        },
        {
            "jpName": "ダイタクヘリオス",
            "enName": "Daitaku Helios",
            "jpText": "～～～～っっっ！！\nうるわぁああああああっしょあぁぁ！！",
            "enText": "HNNNNNNGH!!\nLET'S GOOOOOOOOOO!!",
            "nextBlock": 11,
            "voiceIdx": 9,
            "pathId": 5408602566643328984,
            "blockIdx": 10
        },
        {
            "jpName": "ダイイチルビー",
            "enName": "Daiichi Ruby",
            "jpText": "……っ？",
            "enText": "…?",
            "nextBlock": 12,
            "voiceIdx": 10,
            "pathId": 5366757695827128075,
            "blockIdx": 11
        },
        {
            "jpName": "メジロパーマー",
            "enName": "Mejiro Palmer",
            "jpText": "あー大丈夫大丈夫、気にしないで！\nめっちゃ喜んでるだけだから。\nよかったねぇ、ヘリオス！",
            "enText": "Oh, uh, she's fine, don't mind her. She's just \nreally happy. Good for you, Helios!",
            "nextBlock": -1,
            "voiceIdx": 11,
            "pathId": -2465540798679337008,
            "blockIdx": 12
        }
    ],
