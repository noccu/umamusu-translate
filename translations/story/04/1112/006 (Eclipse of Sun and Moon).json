        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "……Oh, my gosh. You are an eager beaver.\n本当、頑張り屋さんなんだから。",
            "enText": "……Oh, my gosh. You are an eager beaver. \nYou're quite the hard worker.",
            "nextBlock": 30,
            "origClipLength": 317,
            "voiceIdx": 21,
            "animData": [
                {
                    "origLen": 202,
                    "pathId": 5198227630636332114
                }
