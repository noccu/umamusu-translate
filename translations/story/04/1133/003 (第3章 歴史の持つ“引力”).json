            "pathId": -3255115346455357464,
            "blockIdx": 28
        },
        {
            "jpName": "クロノジェネシス",
            "enName": "Chrono Genesis",
            "jpText": "か、考えすぎ、ですか……？",
            "enText": "O-Overthinking… you say…?",
            "nextBlock": 30,
            "origClipLength": 87,
            "voiceIdx": 23,
            "animData": [
                {
                    "origLen": 121,
                    "pathId": -8932067371838334849
