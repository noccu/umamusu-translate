    "text": [
        {
            "jpName": "スーパークリーク",
            "enName": "Super Creek",
            "jpText": "トレーナーさん、休憩されるなら\nここが空いていますよ～。",
            "enText": "Trainer, if you're going to take a break, \nwhy don't you sit here next to me?",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": -5764293340094272332,
            "blockIdx": 1
        },
        {
            "jpName": "スーパークリーク",
            "enName": "Super Creek",
            "jpText": "お疲れではありませんか？\nさあ、どうぞ――",
            "enText": "You must be exhausted. Here, you can ——",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": 2676388751641230189,
            "blockIdx": 2
        },
        {
            "jpName": "スーパークリーク",
            "enName": "Super Creek",
            "jpText": "……あ、でもここじゃ\n横にはなれませんね。",
            "enText": "Ah, I suppose you can't really \nlie down here, can you?",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": 5542455321788736960,
            "blockIdx": 3
        },
        {
            "jpName": "スーパークリーク",
            "enName": "Super Creek",
            "jpText": "折角、お膝があいているのに……\n残念です。",
            "enText": "That's a shame, I would've \nlet you sleep on my lap…",
            "nextBlock": -1,
            "voiceIdx": 3,
            "pathId": 6213443531465934410,
            "blockIdx": 4
        }
    ],
