                }
            ],
            "pathId": 3692156613682207086,
            "blockIdx": 24
        },
        {
            "jpName": "ステイゴールド",
            "enName": "Stay Gold",
            "jpText": "……スズカ。\nお前は今、どこにいる？",
            "enText": "……Suzuka. Just where are you right now?",
