            "pathId": -6788249676764336380,
            "blockIdx": 38
        },
        {
            "jpName": "クロノジェネシス",
            "enName": "Chrono Genesis",
            "jpText": "な、なるほど……私らしい走り、を意識しなくても……。\n…………。",
            "enText": "I-I see…even without being conscious of what \"my\" way of running is… \n………….",
            "nextBlock": 40,
            "origClipLength": 271,
            "voiceIdx": 30,
            "choices": [
                {
                    "jpText": "（まだ何か思案してる顔だな……）",
                    "enText": "(She's still got that pensive look on her face…)",
                    "nextBlock": 40
                },
                {
                    "jpText": "（まだ何か思案してる顔だね……）",
                    "enText": "(She's still got that pensive look on her face…)",
                    "nextBlock": 40
                }
            ],
            "animData": [
                {
