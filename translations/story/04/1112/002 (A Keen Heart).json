            "pathId": -5654267296763033716,
            "blockIdx": 7
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "私が負けているのは――physiqueよ。\n競り合いを制するには、肉体面の強化が重要なの。",
            "enText": "But where I lose to them is――physique. \nTo win in competition, increasing physical strength is important.",
            "nextBlock": 9,
            "origClipLength": 242,
            "voiceIdx": 4,
            "animData": [
                {
                    "origLen": 170,
                    "pathId": -3670319798983238573
                },
                {
                    "origLen": 47,
                    "pathId": -9203455717476244249
                },
