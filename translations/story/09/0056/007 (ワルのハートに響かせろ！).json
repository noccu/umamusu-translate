            "pathId": 4275658882396579380,
            "blockIdx": 18
        },
        {
            "jpName": "シンコウウインディ",
            "enName": "Shinko Windy",
            "jpText": "フェノーメノにも、ワルを見込まれたのだ！\nアイツはまあ……なかなか、見る目があるヤツだったのだ。",
            "enText": "Even Fenomeno had high hopes for my badness! \nI guess… I guess she has pretty good taste, huh!",
            "nextBlock": 20,
            "origClipLength": 258,
            "voiceIdx": 18,
            "animData": [
                {
                    "origLen": 279,
                    "pathId": -9114991126723830902
