        {
            "jpName": "ステイゴールド",
            "enName": "Stay Gold",
            "jpText": "今日のスズカの走り、\nあんたから見てどうだった？",
            "enText": "Suzuka's run today, how would \nyou describe it?",
            "nextBlock": 23,
            "origClipLength": 76,
            "voiceIdx": 68,
            "choices": [
                {
                    "jpText": "……凄まじかったよ",
                    "enText": "……I was awestruck",
