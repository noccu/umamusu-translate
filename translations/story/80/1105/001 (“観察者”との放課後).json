            "pathId": -2925178563936909174,
            "blockIdx": 23
        },
        {
            "jpName": "クラスメイトのウマ娘",
            "enName": "Classmate",
            "jpText": "いや～、ユニヴァースさんがいなかったら\n無理だったよ。手伝ってくれてありがと！",
            "enText": "Aaah, I really couldn't have done it without \nyou, thanks so much for helping out!",
            "nextBlock": 25,
            "origClipLength": 95,
            "voiceIdx": -1,
            "choices": [
                {
                    "jpText": "大変だっただろう、お疲れ様！",
                    "enText": "That was a tough one, good job everyone!",
                    "nextBlock": 25
                },
                {
                    "jpText": "大変だったでしょ、お疲れ様！",
                    "enText": "That was a tough one, good job everyone!",
                    "nextBlock": 25
                }
            ],
            "animData": [
                {
                    "origLen": 187,
                    "pathId": 4506377403389592145
