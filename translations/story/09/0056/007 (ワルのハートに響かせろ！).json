            "pathId": -1517715500500213033,
            "blockIdx": 19
        },
        {
            "jpName": "ビコーペガサス",
            "enName": "Biko Pegasus",
            "jpText": "ふふっ、そうだな。隊長はアタシたちを認めて、必要としてくれた。\nその期待に、応えるんだ！",
            "enText": "Hehe, she sure does. She really appreciated us, and treated us \nlike she needed us. So we're gonna return the favor!",
            "nextBlock": 21,
            "origClipLength": 288,
            "voiceIdx": 19,
            "animData": [
