            "enName": "Casino Drive",
            "jpText": "『Breeders' Cup』での、\n輝かしい勝利をもって！",
            "enText": "A grand victory at the Breeders' Cup!",
            "nextBlock": 8,
            "origClipLength": 139,
            "voiceIdx": 5,
            "animData": [
