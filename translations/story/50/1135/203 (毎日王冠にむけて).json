            "pathId": 4692006580441460117,
            "blockIdx": 23
        },
        {
            "jpName": "ステイゴールド",
            "enName": "Stay Gold",
            "jpText": "……聞こえちゃいない、か。\n……完璧に入りこんでいるな。",
            "enText": "……Can't hear me at all huh. \n……She's completely in the zone.",
            "nextBlock": 25,
            "origClipLength": 81,
            "voiceIdx": 35,
            "animData": [
                {
                    "origLen": 83,
                    "pathId": -7404062913923703977
