            "pathId": -8635414735653391770,
            "blockIdx": 26
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "フフッ……大丈夫よ、ちっとも怖くないわ。\nCome on!　あなたの大胆なハートを見せて？",
            "enText": "Fufuu……it's fine, they're not scary at all. \nCome on! Why don't you show me your Daring Heart too?",
            "nextBlock": 28,
            "origClipLength": 284,
            "voiceIdx": 20,
            "choices": [
                {
                    "jpText": "（うう……）",
                    "enText": "(Ugh……)",
