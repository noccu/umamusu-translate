            "pathId": -2389980694087454708,
            "blockIdx": 6
        },
        {
            "jpName": "フェノーメノ",
            "enName": "Fenomeno",
            "jpText": "う、ウインディさんっ！　あまり無理に引っ張ってはいけません！！\n棚ごと倒れたらどうするんです！　手を放して！",
            "enText": "W-Windy-san! You shouldn't keep pulling on it! \nWhat if the shelf falls over!? Drop it, now!",
            "nextBlock": 8,
            "origClipLength": 222,
            "voiceIdx": 6,
            "animData": [
                {
                    "origLen": 60,
                    "pathId": -3766469497153562559
