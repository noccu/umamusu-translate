{
    "version": 6,
    "bundle": "HA7AOGCKH6OLC7HX7FHR3OTQ6Z3CE2WO",
    "type": "home",
    "storyId": "00000030000002",
    "title": "0",
    "enTitle": "",
    "text": [
        {
            "jpName": "ヒシアマゾン",
            "enName": "Hishi Amazon",
            "jpText": "なぁ、フジにブライアン。\r\nひとつ頼まれちゃくれないか？",
            "enText": "Hey, Fuji, Brian. Can I ask you for a favor?",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": -4269123932155121910,
            "blockIdx": 1
        },
        {
            "jpName": "ナリタブライアン",
            "enName": "Narita Brian",
            "jpText": "なんだ？\r\n……タイマンか？",
            "enText": "What… Another one-on-one?",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": -8028798025968909452,
            "blockIdx": 2
        },
        {
            "jpName": "フジキセキ",
            "enName": "Fuji Kiseki",
            "jpText": "残念だけど、\r\nこの後は予定があってね。",
            "enText": "Sorry, but I unfortunately have plans.",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": -5997757580551316265,
            "blockIdx": 3
        },
        {
            "jpName": "ヒシアマゾン",
            "enName": "Hishi Amazon",
            "jpText": "ちっがーう！　アタシがいつも\r\nタイマン張ってばっかだと思うなよ！",
            "enText": "That's not it! C'mon, you seriously think\nthat's all I ever say?!",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": -3499272615387843928,
            "blockIdx": 4
        },
        {
            "jpName": "フジキセキ",
            "enName": "Fuji Kiseki",
            "jpText": "ごめんごめん。\r\nで、どんなお願いかな？",
            "enText": "Sorry, just teasing. So what is it?",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": 2533476185669425833,
            "blockIdx": 5
        },
        {
            "jpName": "ヒシアマゾン",
            "enName": "Hishi Amazon",
            "jpText": "寮の子がホームシックでさ。\r\n景気づけに郷土料理を作ってやろうと思って。",
            "enText": "One of the students in the dorms is feeling\nhomesick. I was thinking of cooking up some\nlocal delicacies for her.",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": -2710536056225323451,
            "blockIdx": 6
        },
        {
            "jpName": "ヒシアマゾン",
            "enName": "Hishi Amazon",
            "jpText": "明日の昼休み、\r\n味見してもらってもいいかい？",
            "enText": "You guys free for lunch tomorrow?\nI need some taste-testers.",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": -994069012497388748,
            "blockIdx": 7
        },
        {
            "jpName": "ナリタブライアン",
            "enName": "Narita Brian",
            "jpText": "ああ、構わん。",
            "enText": "Sure, I'll be there.",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": -7084899518059428296,
            "blockIdx": 8
        },
        {
            "jpName": "フジキセキ",
            "enName": "Fuji Kiseki",
            "jpText": "お？\r\nブライアンが即答なんて珍しいね。",
            "enText": "Oh? A prompt answer? From Brian?",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": -5688947272243026620,
            "blockIdx": 9
        },
        {
            "jpName": "ナリタブライアン",
            "enName": "Narita Brian",
            "jpText": "アマさんの料理は絶品だからな。\r\n味見だけなら面倒もない。",
            "enText": "Ama's cooking is just that good.\nNothing tedious about tasting her cooking.",
            "nextBlock": 11,
            "voiceIdx": 9,
            "pathId": 1517423604490444841,
            "blockIdx": 10
        },
        {
            "jpName": "フジキセキ",
            "enName": "Fuji Kiseki",
            "jpText": "なるほど。\r\n私もヒシアマの料理は好きだし、大歓迎だ！",
            "enText": "I see. Well, I also enjoy Hishiama's cooking,\nso I'll be there as well!",
            "nextBlock": 12,
            "voiceIdx": 10,
            "pathId": 3177618625867483105,
            "blockIdx": 11
        },
        {
            "jpName": "ヒシアマゾン",
            "enName": "Hishi Amazon",
            "jpText": "サンキュー！\r\nよろしく頼むよ、2人とも！",
            "enText": "Thank you! I'm counting on you guys!",
            "nextBlock": -1,
            "voiceIdx": 11,
            "pathId": 1310002994694840527,
            "blockIdx": 12
        }
    ],
    "modified": 1780176971,
    "humanTl": true
}