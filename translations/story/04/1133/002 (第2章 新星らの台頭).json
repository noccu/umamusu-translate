            "pathId": 5908830967303781838,
            "blockIdx": 24
        },
        {
            "jpName": "クロノジェネシス",
            "enName": "Chrono Genesis",
            "jpText": "（余力はある。位置もいい。\nあとは、適切なタイミングで――）",
            "enText": "(I still have plenty in the tank. My position is good. \nNow, I just need to wait for the right timing—)",
            "nextBlock": 26,
            "origClipLength": 175,
            "voiceIdx": 19,
            "animData": [
                {
                    "origLen": 216,
                    "pathId": -1411249561446758462
