    "text": [
        {
            "jpName": "グラスワンダー",
            "enName": "Grass Wonder",
            "jpText": "エル、見てましたよ～？\r\n授業中にちょっと居眠りしてましたね？",
            "enText": "El, were you napping during class? \nWhen I looked over, you were \nuncharacteristically still…",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": -6430339247455589668,
            "blockIdx": 1
        },
        {
            "jpName": "エルコンドルパサー",
            "enName": "El Condor Pasa",
            "jpText": "ケッ！？　き、気のせいじゃないデスか？\r\n睡魔、厳禁、絶対！　寝てませんよ！",
            "enText": "¿¡Qué!? Y-You must be imagining things! \nSleeping in class is forbidden! Prohibited! \nAbsolutely not allowed!",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": -3523221454205851791,
            "blockIdx": 2
        },
        {
            "jpName": "グラスワンダー",
            "enName": "Grass Wonder",
            "jpText": "背筋は伸びてましたけど……\r\nしっかり船を漕いでるのが見えましたよ？",
            "enText": "What a lovely sentiment… But I saw you \nnodding off, so please stop lying.",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": 5280153954639446495,
            "blockIdx": 3
        },
        {
            "jpName": "エルコンドルパサー",
            "enName": "El Condor Pasa",
            "jpText": "あおぅ……グラスの目はごまかせ\r\nませんか……。",
            "enText": "Awww… I guess I can't fool you, Grass…",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": -8045375593276219910,
            "blockIdx": 4
        },
        {
            "jpName": "エルコンドルパサー",
            "enName": "El Condor Pasa",
            "jpText": "早起きして、走る時間を増やそうとしたん\r\nデスけど……ちょっぴり睡眠不足デェス……。",
            "enText": "I've been trying to wake up early to get in \na bit more running, but… now I'm so sleepy…",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": -1830735441190572791,
            "blockIdx": 5
        },
        {
            "jpName": "グラスワンダー",
            "enName": "Grass Wonder",
            "jpText": "……しかたないですね。ノート、\r\n見せてあげるのは今回だけですよ？",
            "enText": "<i>Sigh…</i> I <i>suppose</i> I could show you \nmy class notes just this once.",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": -8594469912883025356,
            "blockIdx": 6
        },
        {
            "jpName": "エルコンドルパサー",
            "enName": "El Condor Pasa",
            "jpText": "グラァス……！　グラシアス！！\r\n感謝、感激、エル感動！！",
            "enText": "Grass… ¡Gracias! You have my gratitude! \nAppreciation! My deepest thanks!",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": -8819133514428174995,
            "blockIdx": 7
        },
        {
            "jpName": "エルコンドルパサー",
            "enName": "El Condor Pasa",
            "jpText": "あれ？　グラスにノートを見せてもらえると\r\nいうことは、授業中にうたたねしても……。",
            "enText": "Hm? Wait, if you're going to \nshow me your notes, then I can \ntake a short siesta during ——",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": -509838528053593219,
            "blockIdx": 8
        },
        {
            "jpName": "グラスワンダー",
            "enName": "Grass Wonder",
            "jpText": "エ～ル～……？",
            "enText": "<i>El…</i>\n",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": -7422731078623762481,
            "blockIdx": 9
        },
        {
            "jpName": "エルコンドルパサー",
            "enName": "El Condor Pasa",
            "jpText": "う、うそデェース！",
            "enText": "J-Just kidding!",
            "nextBlock": -1,
            "voiceIdx": 9,
            "pathId": 2011394811758882329,
            "blockIdx": 10
        }
    ],
