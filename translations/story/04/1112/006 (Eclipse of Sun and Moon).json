            "pathId": 4479653029520066527,
            "blockIdx": 18
        },
        {
            "jpName": "ハートの友人",
            "enName": "Heart's Friends",
            "jpText": "もちろん出る出る～！\nトレーナーさんはどうします？　出ます？　出ちゃいます！？",
            "enText": "Of course I'm entering too～! Trainer-san, \nhow about you? Entering? You gonna enter too!?",
            "nextBlock": 20,
            "origClipLength": 218,
            "voiceIdx": 14,
            "choices": [
                {
                    "jpText": "え！？えっと……",
                    "enText": "Eh!? Um……",
