            "pathId": 4564596940498277941,
            "blockIdx": 21
        },
        {
            "jpName": "クロノジェネシス",
            "enName": "Chrono Genesis",
            "jpText": "（4番が抑えきれない様子で上がってくる。\nこれは……パッと、思いつくのは）",
            "enText": "(#4 seems unable to hold back and is moving forward. This is… the first thing that comes to mind is…)",
            "nextBlock": 23,
            "origClipLength": 192,
            "voiceIdx": 16,
            "animData": [
                {
                    "origLen": 368,
                    "pathId": -3839217579729361809
                }
            ],
            "pathId": 8155500970868421472,
            "blockIdx": 22
        },
        {
            "jpName": "クロノジェネシス",
            "enName": "Chrono Genesis",
            "jpText": "『アイビーS』……7番が勝った年の……。",
            "enText": "The 『Ivy Stakes』…from the year #7 won…",
            "nextBlock": 24,
            "origClipLength": 120,
            "voiceIdx": 17,
            "animData": [
                {
                    "origLen": 181,
                    "pathId": 4757068067750446845
                }
            ],
            "pathId": 4538771457492030566,
            "blockIdx": 23
        },
        {
            "jpName": "クロノジェネシス",
            "enName": "Chrono Genesis",
            "jpText": "（あの時の勝ちウマ娘は、先行――\nこの位置で間違ってない）",
            "enText": "(The winning horsegirl back then was a front-runner — this position isn't a mistake)",
            "nextBlock": 25,
            "origClipLength": 170,
            "voiceIdx": 18,
            "animData": [
                {
                    "origLen": 181,
                    "pathId": 5507177264475524447
                },
                {
                    "origLen": 16,
                    "pathId": 4995741806323128129
                }
