    "text": [
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "ねえねえ、トレーナー！\nお腹すいてない～？",
            "enText": "Trainer! Trainer! Is your tummy growling?",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": -7731273107220759102,
            "blockIdx": 1
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "昨日ね、トレーナーにあげる用の\nにんじんパン買ったんだ～！",
            "enText": "Well, guess what? I bought some \ncarrot bread just for you!",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": -2769142517984236794,
            "blockIdx": 2
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "すっごくおいしいから、\nぜったい食べてみてほしいの！",
            "enText": "It's super-duper yummy, so you \ndefinitely gotta try it!",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": -2537451017596683906,
            "blockIdx": 3
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "教室の机の中にあるからね、\r\n食べたくなったらいつでも――",
            "enText": "I left it in my desk, so if you ever \nfeel hungry, just ——",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": 1541563894941803889,
            "blockIdx": 4
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "……あっ！",
            "enText": "Ah!",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": 8775894235404102566,
            "blockIdx": 5
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "しまった……忘れてた……！",
            "enText": "I… I forgot!",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 4023762912751764470,
            "blockIdx": 6
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "買ったけど、おいしそうすぎて\n食べちゃったんだった……！",
            "enText": "I <i>did</i> buy it for you, but it looked so good \nthat I ate it without thinking…!",
            "nextBlock": -1,
            "voiceIdx": 6,
            "pathId": -4513664609707192374,
            "blockIdx": 7
        }
