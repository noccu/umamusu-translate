                    "origLen": 112,
                    "pathId": 5813904474358742030
                }
            ],
            "pathId": 7909367074979826852,
            "blockIdx": 35
        },
        {
            "jpName": "クロノジェネシス",
            "enName": "Chrono Genesis",
            "jpText": "これまで、歴史を参考に走ることばかりしてきたので……。\nなにも参照しないで、と言われると、その……。",
            "enText": "Until now, I've only ever run by using history as my guide… So, when I'm told not to reference anything, well…",
            "nextBlock": 37,
            "origClipLength": 304,
            "voiceIdx": 28,
            "animData": [
                {
                    "origLen": 225,
                    "pathId": -8339713556087210001
                },
                {
                    "origLen": 21,
                    "pathId": 4092118092068207999
                }
