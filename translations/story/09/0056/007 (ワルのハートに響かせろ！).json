            "pathId": 8890068881816529150,
            "blockIdx": 1
        },
        {
            "jpName": "シンコウウインディ",
            "enName": "Shinko Windy",
            "jpText": "返事を書いた付箋が、全部はがされてるのだ。ひどいヤツらなのだ！\n……さすが、ワルなのだ。",
            "enText": "They ripped off all your sticky notes. That's so mean! \n…I guess they really are bad guys.",
            "nextBlock": 3,
            "origClipLength": 276,
            "voiceIdx": 1,
            "animData": [
                {
                    "origLen": 312,
                    "pathId": 8706838481394823461
