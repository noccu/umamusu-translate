            "pathId": -8061364681146006799,
            "blockIdx": 22
        },
        {
            "jpName": "ミホノブルボン",
            "enName": "Mihono Bourbon",
            "jpText": "私もライスさんの活躍をずっと待っていました。\n勝つために、トレーニングを頑張りましょう。",
            "enText": "I've been waiting for you to return to form. Hopefully this session \nbrings you closer to a win.",
            "nextBlock": 24,
            "origClipLength": 213,
            "voiceIdx": 14,
            "animData": [
                {
                    "origLen": 257,
                    "pathId": -7921612673631964639
                },
                {
                    "origLen": 294,
                    "pathId": -6996814633467198557
                },
                {
                    "origLen": 279,
                    "pathId": -1316094472132760741
                },
                {
                    "origLen": 272,
                    "pathId": -2307025074722110929
                },
                {
                    "origLen": 157,
                    "pathId": -2826895623336539955
                },
                {
                    "origLen": 96,
                    "pathId": -1690730863491412051
                }
            ],
            "pathId": 4206967808588692679,
            "blockIdx": 23
        },
        {
            "jpName": "ライスシャワー",
            "enName": "Rice Shower",
            "jpText": "ブルボンさん……ライスのためにありがとう！",
            "enText": "Bourbon… You're the best!",
            "nextBlock": 25,
            "origClipLength": 126,
            "voiceIdx": 15,
            "animData": [
                {
                    "origLen": 85,
                    "pathId": -5220915722084088485
                },
                {
                    "origLen": 294,
                    "pathId": 4281110444444465814
                },
                {
                    "origLen": 279,
                    "pathId": 8130434896321600647
                },
                {
                    "origLen": 148,
                    "pathId": 1461589065579755285
                },
                {
                    "origLen": 157,
                    "pathId": -1650167886509597847
                },
                {
                    "origLen": 96,
                    "pathId": -6262986779325488135
                }
            ],
            "pathId": -552251014987471569,
            "blockIdx": 24
        },
        {
            "jpName": "メジロマックイーン",
            "enName": "Mejiro McQueen",
            "jpText": "さあ、それでは以前と同じように、\n私とブルボンさんの後ろについてきてください。",
            "enText": "Now then, just like old times, I want you to follow right behind \nBourbon and me.",
            "nextBlock": 26,
            "origClipLength": 204,
            "voiceIdx": 16,
            "animData": [
                {
                    "origLen": 302,
                    "pathId": -5687105178040879401
                },
                {
                    "origLen": 192,
                    "pathId": -3387726570218356112
                },
                {
                    "origLen": 294,
                    "pathId": 231482678542923292
                },
                {
                    "origLen": 179,
                    "pathId": 2742542060187336031
                },
                {
                    "origLen": 20,
                    "pathId": -1644984450562852377
                },
                {
                    "origLen": 227,
                    "pathId": 1455932442114675146
                },
                {
                    "origLen": 114,
                    "pathId": 4812866974399721753
                }
            ],
            "pathId": -8045317852450940574,
            "blockIdx": 25
        },
        {
            "jpName": "ライスシャワー",
            "enName": "Rice Shower",
            "jpText": "うん、マックイーンさんとブルボンさんについてく！",
            "enText": "Right! Just keep following you and Bourbon!",
            "nextBlock": 27,
            "origClipLength": 122,
            "voiceIdx": 17,
            "animData": [
                {
                    "origLen": 124,
                    "pathId": 3414548742826410106
                },
                {
                    "origLen": 21,
                    "pathId": -1146704646798227569
                },
                {
                    "origLen": 294,
                    "pathId": -6158276975821229016
                },
                {
                    "origLen": 179,
                    "pathId": -7799156414490751374
                },
                {
                    "origLen": 227,
                    "pathId": -2465783959890269391
                },
                {
                    "origLen": 20,
                    "pathId": 5086186244308664318
                }
            ],
            "pathId": -8944769200089776952,
            "blockIdx": 26
        },
        {
            "jpName": "メジロマックイーン",
            "enName": "Mejiro McQueen",
            "jpText": "……あ、でも私生活にまでついてこなくても大丈夫です。\r\n今回は、常識の範囲内でお願いしますわ……。",
            "enText": "…Just to clarify, that does <i>not</i> include in our private lives. Follow \nwithin reason, please.",
            "nextBlock": 28,
            "origClipLength": 284,
            "voiceIdx": 18,
            "animData": [
                {
                    "origLen": 296,
                    "pathId": -455488033555635178
                },
                {
                    "origLen": 306,
                    "pathId": -1527333728027161930
                },
                {
                    "origLen": 122,
                    "pathId": 9105939984401340550
                },
                {
                    "origLen": 20,
                    "pathId": 3047159814785267736
                },
                {
                    "origLen": 302,
                    "pathId": 1200304456352603271
                }
            ],
            "pathId": -1537574941624984708,
            "blockIdx": 27
        },
        {
            "jpName": "ゴールドシップ",
            "enName": "Gold Ship",
            "jpText": "うっしゃ！　んじゃアタシは後ろからライスを追う！\n追いついたら尻尾をひっぱるからな！",
            "enText": "All right! I'll chase Rice from behind then! And when I catch up to her, \nI'll yank her tail!",
            "nextBlock": 29,
            "origClipLength": 214,
            "voiceIdx": 19,
            "animData": [
                {
                    "origLen": 162,
                    "pathId": -7784417772013618692
                },
