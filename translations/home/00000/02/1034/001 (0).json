    "text": [
        {
            "jpName": "ツインターボ",
            "enName": "Twin Turbo",
            "jpText": "イナリ、イナリー！\n聞いてくれ、今日のターボすごいんだぞ！",
            "enText": "Inari, Inari! You gotta hear this!\nI did something amazing today!",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": -2699177957923829378,
            "blockIdx": 1
        },
        {
            "jpName": "イナリワン",
            "enName": "Inari One",
            "jpText": "おうおう、どうした。\r\nそんなに息切らして。",
            "enText": "Whoa, whoa, what's the hubbub?\nTake a breath.",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": 7657105294498456096,
            "blockIdx": 2
        },
        {
            "jpName": "ツインターボ",
            "enName": "Twin Turbo",
            "jpText": "あのね、今日ターボ、\nテイオーと一緒に昼ごはん食べたんだ！",
            "enText": "I can't help it. Today, I ate lunch together\nwith Teio!",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": -3198470654611132389,
            "blockIdx": 3
        },
        {
            "jpName": "イナリワン",
            "enName": "Inari One",
            "jpText": "へぇ、そうかい。それで？",
            "enText": "Ohhh, isn't that somethin'. And?",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": 5726982540570706218,
            "blockIdx": 4
        },
        {
            "jpName": "ツインターボ",
            "enName": "Twin Turbo",
            "jpText": "ターボね、テイオーより1杯多くごはん\n食べたんだぞ！　すごいだろー？",
            "enText": "Get this — I had one more bowl of rice\nthan she did! Amazing, right?!",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": 8760660987769662529,
            "blockIdx": 5
        },
        {
            "jpName": "イナリワン",
            "enName": "Inari One",
            "jpText": "おお、やるじゃねえか！\r\n大した心意気だ、ターボ！",
            "enText": "Wow, big props to you! That's some real\nspirit ya got there, Turbo!",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 199686327897137076,
            "blockIdx": 6
        },
        {
            "jpName": "ツインターボ",
            "enName": "Twin Turbo",
            "jpText": "……ほんと？　ターボえらい？",
            "enText": "Really? You think I did good?",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": 2069850620432177192,
            "blockIdx": 7
        },
        {
            "jpName": "イナリワン",
            "enName": "Inari One",
            "jpText": "ああ、走るにはしっかり食べなきゃいけねえ。\nそれができるターボはえらいさ！",
            "enText": "Yeah — ya gotta eat well to run well,\nthat's for sure. And you can eat with\nthe best of 'em!",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": -7733751579563950046,
            "blockIdx": 8
        },
        {
            "jpName": "ツインターボ",
            "enName": "Twin Turbo",
            "jpText": "えへ、えへへ……！　えへへっ！\nイナリ、もっとも～っと褒めていいぞー♪",
            "enText": "Hehe… eheheh! Hehehe! Go on, Inari,\nsay even more cool stuff about me♪",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": -651010803242740736,
            "blockIdx": 9
        },
        {
            "jpName": "イナリワン",
            "enName": "Inari One",
            "jpText": "ははっ、いい顔しやがる。\nこれだから放っちゃおけねえや。",
            "enText": "Haha, look at the smirk on your mug.\nY'know I can't refuse a face like that.",
            "nextBlock": -1,
            "voiceIdx": 9,
            "pathId": -837889776257215737,
            "blockIdx": 10
        }
    ],
    "modified": 1780172476,
    "humanTl": true
}