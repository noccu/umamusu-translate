    "text": [
        {
            "jpName": "スペシャルウィーク",
            "enName": "Special Week",
            "jpText": "あの、デジタルさんっ。\r\nずっと聞きたいことがあったんですけど……。",
            "enText": "Um, Digital… There's something I've been\nmeaning to ask you…",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": 6256832946202856899,
            "blockIdx": 1
        },
        {
            "jpName": "アグネスデジタル",
            "enName": "Agnes Digital",
            "jpText": "はわわわっ、あたくしめにどんな質問が！？",
            "enText": "<i>Hwaughhh!</i> You have a question for <i>me</i>?!",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": -5780151921156412401,
            "blockIdx": 2
        },
        {
            "jpName": "アグネスデジタル",
            "enName": "Agnes Digital",
            "jpText": "どんなことだって、答えます！！\r\nなんでも仰ってくださいまし～！！",
            "enText": "I'm an open book! Please ask me\nanything you want!!",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": -1705558567925159890,
            "blockIdx": 3
        },
        {
            "jpName": "スペシャルウィーク",
            "enName": "Special Week",
            "jpText": "ありがとうございます！\r\nでは、えっと……。",
            "enText": "Okay, thank you! I was wondering…",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": 8574999041992685719,
            "blockIdx": 4
        },
        {
            "jpName": "スペシャルウィーク",
            "enName": "Special Week",
            "jpText": "『次の新刊』ってなんのことですか！？",
            "enText": "What does \"the next volume\" mean?!",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": 5089233800548223217,
            "blockIdx": 5
        },
        {
            "jpName": "アグネスデジタル",
            "enName": "Agnes Digital",
            "jpText": "ぐほぁ！？！？！？",
            "enText": "<i>HEURGH?!</i>",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": -6378764240480467067,
            "blockIdx": 6
        },
        {
            "jpName": "スペシャルウィーク",
            "enName": "Special Week",
            "jpText": "すごく楽しそうにしながら\r\n『次のウマ娘ちゃんの新刊はこれだ～！』\nって仰ってたので、気になって……！",
            "enText": "You looked really excited when you said\n\"This is totally going in the next volume!\",\nso I've been curious about it…!",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": 1221379304400396945,
            "blockIdx": 7
        },
        {
            "jpName": "アグネスデジタル",
            "enName": "Agnes Digital",
            "jpText": "ひぃぃ！　バ、バカな……！\r\n声に、声に出ていた、だと！？\nまさか前後の妄想まで！？",
            "enText": "<i>GASP!</i> I… I can't believe… You mean I… said\nthat out loud?! Don't tell me I was blabbing\nabout my fantasies the whole time?!",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": 8687386516312296144,
            "blockIdx": 8
        },
        {
            "jpName": "スペシャルウィーク",
            "enName": "Special Week",
            "jpText": "『秘密の併走』とか『尻尾のキモチ』とか、\r\nもしかして、流行りの漫画とかですか！？\nそれともトレーニングの本だったり？",
            "enText": "Are <i>The Secret Race</i> and <i>The Feel of Your Tail</i>\npopular manga right now? Or are they training\nbooks or something?",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": 8641787350027687372,
            "blockIdx": 9
        },
        {
            "jpName": "アグネスデジタル",
            "enName": "Agnes Digital",
            "jpText": "ぐぉぉおお！　そ、それは、タイト、ル……！\r\nや、やめっ、もう……ライフが……！！",
            "enText": "<i>HNNNGGG…</i> You even know… the titles!\nN-No more… I'm… dying of cringe!!",
            "nextBlock": 11,
            "voiceIdx": 9,
            "pathId": -7907505565077840969,
            "blockIdx": 10
        },
        {
            "jpName": "スペシャルウィーク",
            "enName": "Special Week",
            "jpText": "ぜひ、教えてください～！！",
            "enText": "Please tell me!!",
            "nextBlock": 12,
            "voiceIdx": 10,
            "pathId": -469133281079167872,
            "blockIdx": 11
        },
        {
            "jpName": "アグネスデジタル",
            "enName": "Agnes Digital",
            "jpText": "許してください～！！",
            "enText": "I'm sorryyyyy!!",
            "nextBlock": -1,
            "voiceIdx": 11,
            "pathId": -3314689598903112217,
            "blockIdx": 12
        }
    ],
    "modified": 1780169232,
    "humanTl": true
}