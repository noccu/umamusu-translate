            "pathId": -5725610086552173277,
            "blockIdx": 8
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "というワケだから、しばらくはひとりランチ続行ね。\n落ち着いたら、また一緒にランチしましょ♪",
            "enText": "So for now, the solo lunches will continue. \nOnce things calm down, let's eat lunch together again♪",
            "nextBlock": 10,
            "origClipLength": 217,
            "voiceIdx": 5,
            "animData": [
                {
                    "origLen": 60,
                    "pathId": -5313324275878299214
                },
                {
                    "origLen": 20,
                    "pathId": 1606764452683306714
                }
            ],
            "pathId": -6387714195025535184,
            "blockIdx": 9
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "......Ugh......so much...",
            "enText": "……Ugh……so much……",
            "nextBlock": 11,
            "origClipLength": 188,
            "voiceIdx": 6,
            "animData": [
                {
