    "text": [
        {
            "jpName": "アグネスデジタル",
            "enName": "Agnes Digital",
            "jpText": "ほびゃああ～～！　沢山のウマ娘ちゃんが\nあた、あたしに『誕生日おめでとー』を～っ！",
            "enText": "<i>Nghahhh</i>! So many horsies w-wishing \n<i>me</i> a happy birthday!",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": 2339121226813516469,
            "blockIdx": 1
        },
        {
            "jpName": "アグネスデジタル",
            "enName": "Agnes Digital",
            "jpText": "全部覚えときたくてガン見しちゃったよぉ、\nはぁ～記憶がしんどい！！　無理ぃ……っ！",
            "enText": "I want to remember all of it so bad I've barely \nblinked! Ahh, my memory's fried! I can't!",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": -6871216427953280161,
            "blockIdx": 2
        },
        {
            "jpName": "メイショウドトウ",
            "enName": "Meisho Doto",
            "jpText": "だ、大丈夫ですかぁ？\nお具合、悪いのですか……？",
            "enText": "A-Are you all right? Do you feel sick…?",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": -9104855256198586189,
            "blockIdx": 3
        },
        {
            "jpName": "テイエムオペラオー",
            "enName": "T.M. Opera O",
            "jpText": "顔色は良すぎるぐらいだね。\nさては、ボクが眩しすぎたのだろうか……。",
            "enText": "I think she feels overwhelmed. Must be a case \nof my aura shining too bright…",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": 2737026279603046439,
            "blockIdx": 4
        },
        {
            "jpName": "アグネスデジタル",
            "enName": "Agnes Digital",
            "jpText": "なあああっ！　最高峰尊みペア！\n――じゃなくてドトウさんにオペラオーさん！",
            "enText": "AHH! It's the peak ship! \n…I mean, hey Doto and Opera O!",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": -5545654528225559197,
            "blockIdx": 5
        },
        {
            "jpName": "アグネスデジタル",
            "enName": "Agnes Digital",
            "jpText": "だ、大丈夫です、お気になさらずっ！\nちょっと、キャパ超えしてただけですからっ！",
            "enText": "I-I'm just fine. Nothing to worry about! \nI was just running a liiittle over capacity \nfor a minute!",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 3612967414110942720,
            "blockIdx": 6
        },
        {
            "jpName": "テイエムオペラオー",
            "enName": "T.M. Opera O",
            "jpText": "うーん、そうかい？\nよくわからないが……そうだ！",
            "enText": "Oh, is that so? Not sure I understand, but… \nAh, I know!",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": 6869476818491040751,
            "blockIdx": 7
        },
        {
            "jpName": "テイエムオペラオー",
            "enName": "T.M. Opera O",
            "jpText": "ボクの麗しい声色でとっておきの\n言葉を贈るよ！　元気を出したまえ！",
            "enText": "I shall gift you a few words in my silvery \nvoice! That ought to reinvigorate you!",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": 3149396624909358455,
            "blockIdx": 8
        },
        {
            "jpName": "テイエムオペラオー",
            "enName": "T.M. Opera O",
            "jpText": "というわけで、\nハッピーバースデー、デジタル君！",
            "enText": "Without further adieu… \nHappy birthday, Digital!",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": 1570629528519592345,
            "blockIdx": 9
        },
        {
            "jpName": "メイショウドトウ",
            "enName": "Meisho Doto",
            "jpText": "あっ、\nお、おめでとうございます～……！",
            "enText": "Ah, um, happy birthday…!",
            "nextBlock": 11,
            "voiceIdx": 9,
            "pathId": -7735612880672893218,
            "blockIdx": 10
        },
        {
            "jpName": "アグネスデジタル",
            "enName": "Agnes Digital",
            "jpText": "――ひゅっ……――",
            "enText": "<i>Eep…!</i>",
            "nextBlock": 12,
            "voiceIdx": 10,
            "pathId": -5564097551635551275,
            "blockIdx": 11
        },
        {
            "jpName": "メイショウドトウ",
            "enName": "Meisho Doto",
            "jpText": "へっ、あれ……！？\nう、動かなくなっちゃいましたぁ……！",
            "enText": "O-Oh no! Sh-She's become a statue!",
            "nextBlock": -1,
            "voiceIdx": 11,
            "pathId": -3429935384726831233,
            "blockIdx": 12
        }
    ],
    "humanTl": true,
