    "text": [
        {
            "jpName": "コパノリッキー",
            "enName": "Copano Rickey",
            "jpText": "このあんこ、すっごいおいしい！\nなんか心がコパコパしてくる味☆\nアキュートさん、どこのお店で買ったの？",
            "enText": "This red bean paste is super delish! It's like\nI'm fully recharged of my Copa energy☆ \nWhere did you buy this stuff, Acute?",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": 7749765506897267379,
            "blockIdx": 1
        },
        {
            "jpName": "ワンダーアキュート",
            "enName": "Wonder Acute",
            "jpText": "喜んでもらえてよかったよぉ。\nこれはほれ、\nあの八百屋さんのお向かいにある……。",
            "enText": "I'm glad you like it! I got it across the street \nfrom the greengrocer down the road.",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": 8807806951850661369,
            "blockIdx": 2
        },
        {
            "jpName": "ホッコータルマエ",
            "enName": "Hokko Tarumae",
            "jpText": "……コパコパ。",
            "enText": "Copa energy…",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": 512355999404512766,
            "blockIdx": 3
        },
        {
            "jpName": "ホッコータルマエ",
            "enName": "Hokko Tarumae",
            "jpText": "『おいしい～♪\n心がタルタルしてくる優しい味だべっ☆』",
            "enText": "<i>Delicious!♪ This sweetness is recharging \nmy Taru energy☆</i>",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": 5414330140999574890,
            "blockIdx": 4
        },
        {
            "jpName": "コパノリッキー",
            "enName": "Copano Rickey",
            "jpText": "わ！　ロコドルモードだ！　急に！？",
            "enText": "Whoa! Is that locadol mode I hear?!",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": 4174524477098788822,
            "blockIdx": 5
        },
        {
            "jpName": "ホッコータルマエ",
            "enName": "Hokko Tarumae",
            "jpText": "『今日も苫小牧をタルっと紹介☆』\n……アリかも。",
            "enText": "<i>It's time for a taruific Tomakomai \nintroduction☆</i> …This might work.",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 3055189395931297698,
            "blockIdx": 6
        },
        {
            "jpName": "ワンダーアキュート",
            "enName": "Wonder Acute",
            "jpText": "おやまあ、リッキーちゃんの真似かい？",
            "enText": "Oh my, are you trying to imitate Rickey?",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": 6582769629935903886,
            "blockIdx": 7
        },
        {
            "jpName": "ホッコータルマエ",
            "enName": "Hokko Tarumae",
            "jpText": "リッキー語、意外とキャラづけの\n参考になるかもしれないなって……。",
            "enText": "Rickeynese is surprisingly full of tips \non how to sell a personality…",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": -2318578517422818128,
            "blockIdx": 8
        },
        {
            "jpName": "ワンダーアキュート",
            "enName": "Wonder Acute",
            "jpText": "『このたい焼き、アキュっとしてるねぇ♪』\n……ふふ、確かに楽しくていいかもねぇ。",
            "enText": "<i>This taiyaki really is a-cutie♪ </i>\n…Hehe, well I admit this is quite fun.",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": 5300637488280409511,
            "blockIdx": 9
        },
        {
            "jpName": "コパノリッキー",
            "enName": "Copano Rickey",
            "jpText": "アキュートさんまで！？",
            "enText": "You too, Acute?!",
            "nextBlock": 11,
            "voiceIdx": 9,
            "pathId": 3233564210246057303,
            "blockIdx": 10
        },
        {
            "jpName": "ホッコータルマエ",
            "enName": "Hokko Tarumae",
            "jpText": "『ホッコー☆　ホッコリ☆　北海道～☆』\n……う～ん、まだ実践は時期尚早。\nもっとじっくり研究してから――",
            "enText": "Hokko☆ hocky☆ Hokkaido!☆ \nHmm… perhaps it could use a bit \nmore workshopping.",
            "nextBlock": 12,
            "voiceIdx": 10,
            "pathId": -469814880678951144,
            "blockIdx": 11
        },
        {
            "jpName": "コパノリッキー",
            "enName": "Copano Rickey",
            "jpText": "えーっと……ま、悪い気はしないし、いっか！\nリッキー☆　ラッキー☆　オールオッケー☆",
            "enText": "Well… it wasn't a bad start. I'll let you take it. \nRickey☆ lucky☆ fine by meee☆",
            "nextBlock": -1,
            "voiceIdx": 11,
            "pathId": -1490877854449860485,
            "blockIdx": 12
        }
