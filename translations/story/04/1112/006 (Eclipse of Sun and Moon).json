        {
            "jpName": "ハートの友人",
            "enName": "Heart's Friend",
            "jpText": "あっ、ハートじゃん！　隣の人は、うわさの担当トレーナーさん？\nはじめまして～！　ってことでカンパーイ☆",
            "enText": "Ah, it's Heart! That person next to you, are they \nthe rumored trainer? Nice to meet you～! And, Cheers☆",
            "nextBlock": 13,
            "origClipLength": 309,
            "voiceIdx": 9,
            "choices": [
                {
                    "jpText": "カ、カンパーイ……",
                    "enText": "C-cheers……",
                    "nextBlock": 13
                }
