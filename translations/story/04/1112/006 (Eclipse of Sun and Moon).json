            "voiceIdx": 11,
            "pathId": 1531491177639378101,
            "blockIdx": 16
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "用意してある衣装や小道具を使って、\n『指令』に相応しい格好に変装するゲームね！",
            "enText": "Using props alongside your costume, \ndisguise in a manner to complete your 『Mission』!",
