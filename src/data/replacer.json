[
    {
        "re": "’",
        "repl": "'"
    },
    {
        "re": "[“”]",
        "repl": "\""
    },
    {
        "re": "\\balot\\b",
        "repl": "a lot"
    },
    {
        "re": "horse girl|uma ?musu(?:me)",
        "repl": "horsegirl",
        "limit": true
    },
    {
        "re": "select(?:ion|ive) race",
        "repl": "Selection Race"
    },
    {
        "comment": "Collapse various period strings to ellipsis",
        "re": "(?: ?\\.){2,4}(?= )|(?:\\.){2,4}|(?<=\\.{3,3})\\.",
        "repl": "…"
    },
    {
        "comment": "Attach loose ellipsis",
        "re": " (…+) ",
        "repl": "\\1 "
    },
    {
        "comment": "Break up double-attached ellipsis",
        "re": "([a-z])…([a-z])",
        "repl": "\\1… \\2"
    },
    {
        "re": "[,:\\.]?…[,:\\.]?",
        "repl": "…"
    },
    {
        "re": "--|(?<=-)-|-$",
        "repl": "―"
    },
    {
        "re": "(?<=[a-zA-Z]{4})- (?=[a-zA-Z])",
        "repl": " — "
    },
    {
        "re": "(?<=[a-zA-Z])—(?=[a-zA-Z])",
        "repl": " — "
    },
    {
        "re": "―",
        "repl": "—"
    },
    {
        "re": "~",
        "repl": "～"
    },
    {
        "re": "？",
        "repl": "?"
    },
    {
        "re": "！",
        "repl": "!"
    },
    {
        "comment": "Unspace special symbols",
        "re": "([\\.?!…]) ([♪☆★])",
        "repl": "\\1\\2"
    },
    {
        "comment": "Remove periods before special symbols",
        "re": "\\.([♪☆★])",
        "repl": "\\1"
    },
    {
        "re": "(?<= )i(?=[' ])",
        "repl": "I",
        "disabled": true
    },
    {
        "re": "(?<=\\S) {2,}",
        "repl": " ",
        "disabled": true
    },
    {
        "comment": "Fix newlines in italic tags",
        "re": " ?(\\\\n|\\n)<\/i>",
        "repl": "<\/i>\\1"
    },
    {
        "re": "[\\.,] ?(…+)(?= ?(?:$|[?!—\\n]))",
        "repl": "\\1"
    },
    {
        "comment": "Multiple per-line trailing spaces",
        "re": " {2,}$",
        "repl": " "
    },
    {
        "re": " *(?<!>)\\n *",
        "repl": " \\n",
        "disabled": true
    },
    {
        "comment": "Attach starting ellipsis",
        "re": "^… |(\\n)… |(\\()…",
        "repl": "\\1\\2…"
    },
    {
        "comment": "Empty ending lines / Trailing spaces",
        "re": "(?-m:\\n *$)",
        "repl": ""
    },
    {
        "comment": "Correct SI value-unit formatting.",
        "re": "(\\d+) ?(m?[mg]){1,2}(?=\\W)",
        "repl": "\\1 \\2"
    }
]