            "pathId": 8208359167316776637,
            "blockIdx": 5
        },
        {
            "jpName": "シンコウウインディ",
            "enName": "Shinko Windy",
            "jpText": "ぐぎぎぎぎ、ビクともしない……なにとつながってるのだ～～！？",
            "enText": "Hnnnnngh, it's not budging… \nWhat the heck is this tied to??",
            "nextBlock": 7,
            "origClipLength": 248,
            "voiceIdx": 5,
            "animData": [
                {
                    "origLen": 273,
                    "pathId": 9080123130148513815
