{
    "version": 6,
    "bundle": "INFF4US2E3Q7UUN57VFYGGZQFQCGE3WM",
    "type": "home",
    "storyId": "00000021045001",
    "title": "0",
    "enTitle": "",
    "text": [
        {
            "jpName": "スーパークリーク",
            "enName": "Super Creek",
            "jpText": "そうそう、イナリちゃん\n聞いてください～。",
            "enText": "Oh, Inari — here's something\nthat might interest you.",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": -5674323349275741967,
            "blockIdx": 1
        },
        {
            "jpName": "スーパークリーク",
            "enName": "Super Creek",
            "jpText": "この前、お出かけした時に\nお神輿を見かけたんです～。",
            "enText": "While I was out and about earlier,\nI saw a portable shrine.",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": -7364492295974135585,
            "blockIdx": 2
        },
        {
            "jpName": "スーパークリーク",
            "enName": "Super Creek",
            "jpText": "地域の小さなお祭りがある\nみたいですね。",
            "enText": "So I think there must be\na local festival going on.",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": 140501880529207640,
            "blockIdx": 3
        },
        {
            "jpName": "イナリワン",
            "enName": "Inari One",
            "jpText": "へぇ！　江戸っ子の血が騒ぐぜ！\nこれは是非とも参加しねぇと！",
            "enText": "Really? That's what this Edo girl likes to hear!\nI've gotta get involved!",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": -6216339440316435405,
            "blockIdx": 4
        },
        {
            "jpName": "スーパークリーク",
            "enName": "Super Creek",
            "jpText": "えっと……お神輿を担ぐんですか？",
            "enText": "Oh, um… Are you thinking of\ncarrying the shrine?",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": -6092459076641722200,
            "blockIdx": 5
        },
        {
            "jpName": "イナリワン",
            "enName": "Inari One",
            "jpText": "あたぼぅよ！\r\n神輿は祭りの華だろうがっ。",
            "enText": "'Course I am! The shrine's the centerpiece\nof a festival!",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 7421478329697070099,
            "blockIdx": 6
        },
        {
            "jpName": "スーパークリーク",
            "enName": "Super Creek",
            "jpText": "でも心配です。\nあんなに大きなお神輿……。",
            "enText": "I'm worried, though. It was so large…",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": -192249339998619291,
            "blockIdx": 7
        },
        {
            "jpName": "イナリワン",
            "enName": "Inari One",
            "jpText": "へっ、な～に言ってんでい。\n神輿のひとつやふたつ、\nかる～く担いで――",
            "enText": "What're you talkin' about? I can lift a portable\nshrine or two any day of the—",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": -8039553353002345398,
            "blockIdx": 8
        },
        {
            "jpName": "スーパークリーク",
            "enName": "Super Creek",
            "jpText": "……イナリちゃん、届くかしら。",
            "enText": "…But won't the other carriers lift you up\nalong with the shrine?",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": 456910464201280940,
            "blockIdx": 9
        },
        {
            "jpName": "イナリワン",
            "enName": "Inari One",
            "jpText": "って、そっちかい！！",
            "enText": "<i>That's</i> what you're worried about?!",
            "nextBlock": -1,
            "voiceIdx": 9,
            "pathId": -2852601465647005943,
            "blockIdx": 10
        }
    ],
    "modified": 1780174455,
    "humanTl": true
}