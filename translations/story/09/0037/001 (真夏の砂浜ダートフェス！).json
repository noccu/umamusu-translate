            "nextBlock": 4,
            "origClipLength": 228,
            "voiceIdx": 2,
            "pathId": 5002174951846135398,
            "blockIdx": 3
        },
        {
            "jpName": "ホッコータルマエ",
            "enName": "",
            "jpText": "（くすっ……いろいろあったのが嘘みたい……！\nううん、いろいろあったから……なのかな！）",
