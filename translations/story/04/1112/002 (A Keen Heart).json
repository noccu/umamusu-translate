            "pathId": -1952368857246025621,
            "blockIdx": 12
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "……、……ふぅ……完食ね。\n――……あら？　Hey!",
            "enText": "…… ……Phew……ate it all. \n――……Oh? Hey!",
            "nextBlock": 14,
            "origClipLength": 394,
            "voiceIdx": 8,
            "choices": [
                {
                    "jpText": "……あっ、ひ、久しぶり！",
                    "enText": "……Ah, uh, it's been a while!",
