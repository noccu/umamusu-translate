            ],
            "pathId": 5455931902335039515,
            "blockIdx": 6
        },
        {
            "jpName": "シンコウウインディ",
            "enName": "Shinko Windy",
            "jpText": "なら、ワルが出てきたくなるような作戦を考えてやるのだ！\nふっふっふ、みてろよ、ワルどもめ～！",
            "enText": "So I'm gonna think of the perfect plan to make \n'em wanna show themselves! \nHehehe, hope you're ready, bad guys!",
            "nextBlock": 8,
            "origClipLength": 364,
            "voiceIdx": 6,
            "animData": [
                {
                    "origLen": 75,
                    "pathId": 8343818326505974966
                },
                {
                    "origLen": 132,
                    "pathId": 4467720047093904938
                },
                {
                    "origLen": 36,
                    "pathId": 3392093987982954170
                },
                {
                    "origLen": 384,
                    "pathId": -8970517282119940881
                },
                {
                    "origLen": 383,
                    "pathId": 8536006676921812229
                }
            ],
            "pathId": 4774139946791355953,
            "blockIdx": 7
        },
        {
            "jpName": "ビコーペガサス",
            "enName": "Biko Pegasus",
            "jpText": "ウインディ先輩、なにか思いついたんだな……！？\nよーしっ、アタシも手伝うぞ！",
            "enText": "Did you come up with something, Windy-senpai!? \nAll right, I'll help!",
            "nextBlock": 9,
            "origClipLength": 200,
            "voiceIdx": 7,
            "animData": [
                {
                    "origLen": 106,
                    "pathId": 6864275178181985313
                },
                {
                    "origLen": 20,
                    "pathId": -3422845109941598611
                },
                {
                    "origLen": 40,
                    "pathId": 2709302784885846048
                }
            ],
            "pathId": 7819002956613045864,
            "blockIdx": 8
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "はいはいっ！　あのね、わたしもう一回、\n“ペースよみ”さんにお返事書いてもいい？",
            "enText": "Me next! So, can I write to Miss Pace Blind again then?",
            "nextBlock": 10,
            "origClipLength": 167,
            "voiceIdx": 8,
            "animData": [
                {
                    "origLen": 135,
                    "pathId": 1043366429986198910
                },
                {
                    "origLen": 30,
                    "pathId": -6306737242834594861
                },
                {
                    "origLen": 10,
                    "pathId": -8055835797199588236
                },
                {
                    "origLen": 10,
                    "pathId": 3201344978953659751
                },
                {
                    "origLen": 265,
                    "pathId": 6411679791989441382
                },
                {
                    "origLen": 128,
                    "pathId": -2870803709339709994
                }
            ],
            "pathId": -6194740790818448604,
            "blockIdx": 9
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "わたしとお話ししたいことがあって、お返事をくれた気がするんだ。\nだからやっぱり、お話しできるまで、がんばってみたいの！",
            "enText": "I feel like she wanted to tell me something. \nSo I wanna keep at it until we can talk!",
            "nextBlock": 11,
            "origClipLength": 258,
            "voiceIdx": 9,
            "animData": [
                {
                    "origLen": 45,
                    "pathId": 529554203054036625
                },
                {
                    "origLen": 20,
                    "pathId": -6801809474792337357
                },
                {
                    "origLen": 167,
                    "pathId": 76375876880297162
                },
                {
                    "origLen": 20,
                    "pathId": -3927689907820147474
                }
            ],
            "pathId": 3405066355595160168,
            "blockIdx": 10
        },
        {
            "jpName": "サムソンビッグ",
            "enName": "Samson Big",
            "jpText": "うん。話しかけ続けたら、いつかはきっと応えてくれるよ！\nまた一緒に書こう、お返事！　あたしも手伝うからさ！",
            "enText": "Yeah! If we keep trying, she's gotta write back \neventually! Let's write a new reply together!",
            "nextBlock": 12,
            "origClipLength": 295,
            "voiceIdx": 10,
            "animData": [
                {
                    "origLen": 167,
                    "pathId": 1060437458623674398
                },
                {
                    "origLen": 16,
                    "pathId": -2344173131570514651
                },
                {
                    "origLen": 103,
                    "pathId": 897548361610359498
                },
                {
                    "origLen": 32,
                    "pathId": 7575367569337131258
                }
            ],
            "pathId": 9115774508589689612,
            "blockIdx": 11
        },
        {
            "jpName": "サムソンビッグ",
            "enName": "Samson Big",
            "jpText": "ふむふむ……負けてここに来てる話を聞いて、ウズウズしたんだね。\nなら、その想いも伝えようよ！",
            "enText": "Hmm… When we found out they were coming here because \nthey lost, you felt like you had to do something, right? \nSo show her how you feel!",
            "nextBlock": 13,
            "origClipLength": 259,
            "voiceIdx": 11,
            "animData": [
                {
                    "origLen": 23,
                    "pathId": -3505650020155543139
                },
                {
                    "origLen": 23,
                    "pathId": 1216648839984225992
                }
            ],
            "pathId": 932948176713493673,
            "blockIdx": 12
        },
        {
            "jpName": "サムソンビッグ",
            "enName": "Samson Big",
            "jpText": "伝わる言葉を、あたしも一緒に考えるから！\nがんばってやり遂げようっ、ウララちゃん！",
            "enText": "I'll help think of ways to get your feelings across! \nLet's do our best and get this done, Urara-chan!",
            "nextBlock": 14,
            "origClipLength": 204,
            "voiceIdx": 12,
            "pathId": -654053048081825177,
            "blockIdx": 13
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "うん！　わたし、今思ってること、全部伝えたい！\nよろしくね、ビッグさん！",
            "enText": "Mmhmm! I wanna tell her everything I feel! \nThanks for helping me, Big-san!",
            "nextBlock": 15,
            "origClipLength": 201,
            "voiceIdx": 13,
            "pathId": -1741198687240235387,
            "blockIdx": 14
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "よーし、がんばるぞ！\nえーとね、『わたしも、逃げの子と走ってね』――",
            "enText": "Okayyyy! Here I go! \nUmm… \"When I race with front runners\"…",
            "nextBlock": 16,
            "origClipLength": 308,
            "voiceIdx": 14,
            "pathId": 8985409574789375854,
            "blockIdx": 15
        },
        {
            "jpName": "ビコーペガサス",
            "enName": "Biko Pegasus",
            "jpText": "えーっ、そんなことやっちゃうのか！？",
            "enText": "Whaaat!? Are you seriously gonna do that!?",
            "nextBlock": 17,
            "origClipLength": 97,
            "voiceIdx": 15,
            "animData": [
                {
                    "origLen": 155,
                    "pathId": 5939611670263980763
                },
                {
                    "origLen": 110,
                    "pathId": -6353460594628523241
