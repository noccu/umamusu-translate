    "text": [
        {
            "jpName": "ナリタブライアン",
            "enName": "Narita Brian",
            "jpText": "チッ……。",
            "enText": "<i>Tch</i>…",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": -9098166021348929831,
            "blockIdx": 1
        },
        {
            "jpName": "ヒシアマゾン",
            "enName": "Hishi Amazon",
            "jpText": "なんだい、シケたツラしやがって。\nアタシが気合い入れなおしてやろうか？",
            "enText": "Sheesh, who spit in your coffee? How about \na race to work out some frustration?",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": 693215428656883142,
            "blockIdx": 2
        },
        {
            "jpName": "ナリタブライアン",
            "enName": "Narita Brian",
            "jpText": "いらん。面倒を増やすな。",
            "enText": "No, I've already got enough trouble.",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": 5873590739132187699,
            "blockIdx": 3
        },
        {
            "jpName": "ナリタブライアン",
            "enName": "Narita Brian",
            "jpText": "実家から荷物が送られてきたんだが、\n大量の野菜が入っていてな……。",
            "enText": "I got a package of vegetables from my family, \nand there's just so many…",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": 5747311483773062830,
            "blockIdx": 4
        },
        {
            "jpName": "ヒシアマゾン",
            "enName": "Hishi Amazon",
            "jpText": "なんだい、そんなことか。なら、さっさと\nアタシに言ってくれりゃよかったのに。",
            "enText": "What? That's it? Why didn't you \nsay so sooner?",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": -2231409808861033833,
            "blockIdx": 5
        },
        {
            "jpName": "ヒシアマゾン",
            "enName": "Hishi Amazon",
            "jpText": "ここにゃ食い盛りのウマ娘が大勢いるんだ。\nアタシがちゃちゃっと料理してやるよ！",
            "enText": "Do you know how many horsegirls here \nhave insane appetites? I'll cook up those \nveggies in a jiffy!",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": -3615041414010187762,
            "blockIdx": 6
        },
        {
            "jpName": "ナリタブライアン",
            "enName": "Narita Brian",
            "jpText": "いいのか？　かなりの量だぞ。",
            "enText": "You sure? There's a lot.",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": 6907873224977474613,
            "blockIdx": 7
        },
        {
            "jpName": "ヒシアマゾン",
            "enName": "Hishi Amazon",
            "jpText": "美浦寮のヒシアマ姐さんをナメんじゃないよ！\nアンタもアタシの料理の腕は知ってるだろ？",
            "enText": "You looking down on the cooking skills of \nMiho dormitory's Hishiama?! I'll make you \neat those words!",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": 6195729844745166255,
            "blockIdx": 8
        },
        {
            "jpName": "ヒシアマゾン",
            "enName": "Hishi Amazon",
            "jpText": "それにもちろんアンタにも食べてもらう！\n野菜嫌いはこのアタシが克服させてやるよ！",
            "enText": "Literally! You're having some too! \nI know you hate veggies, but my \ncooking'll change your mind!",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": 5734017091617779503,
            "blockIdx": 9
        },
        {
            "jpName": "ナリタブライアン",
            "enName": "Narita Brian",
            "jpText": "む、むう……。",
            "enText": "Urgh…",
            "nextBlock": -1,
            "voiceIdx": 9,
            "pathId": -2881798785078806593,
            "blockIdx": 10
        }
    ],
