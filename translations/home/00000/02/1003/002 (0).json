    "text": [
        {
            "jpName": "トウカイテイオー",
            "enName": "Tokai Teio",
            "jpText": "ねえ、マックイーン！\n一緒に野球しない？",
            "enText": "Hey, McQueen! Wanna play \nbaseball together?",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": 2172040872706776276,
            "blockIdx": 1
        },
        {
            "jpName": "トウカイテイオー",
            "enName": "Tokai Teio",
            "jpText": "ちょくちょく野球観戦行くんでしょ？\n人選としては最適かなって！",
            "enText": "You go to games pretty regularly, right? \nI need a teammate, so I figured you'd be \nthe one to ask!",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": 7727849603361158093,
            "blockIdx": 2
        },
        {
            "jpName": "メジロマックイーン",
            "enName": "Mejiro McQueen",
            "jpText": "な、なぜそれを……！？",
            "enText": "H-How did you…!?",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": -5020773169383645916,
            "blockIdx": 3
        },
        {
            "jpName": "トウカイテイオー",
            "enName": "Tokai Teio",
            "jpText": "寮でゴルシと話してるの聞いちゃったー♪\nそんなに好きならやったこともあるでしょ？",
            "enText": "I happened to hear you talking to Golshi, \nthat's all♪ A fan like you must've played \na game or two, right?",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": -4535269628333177554,
            "blockIdx": 4
        },
        {
            "jpName": "メジロマックイーン",
            "enName": "Mejiro McQueen",
            "jpText": "うっ……ないとは言いませんが――",
            "enText": "<i>Urgh</i>… Well, you're not exactly wrong…",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": 7200224603037618695,
            "blockIdx": 5
        },
        {
            "jpName": "トウカイテイオー",
            "enName": "Tokai Teio",
            "jpText": "じゃあやろうよ！\n実際に遊んだ時も面白かったでしょ？",
            "enText": "Then let's play! That should be just \nas fun as watching, right?",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": -7092854994043513147,
            "blockIdx": 6
        },
        {
            "jpName": "トウカイテイオー",
            "enName": "Tokai Teio",
            "jpText": "カキーンって打てた時は\r\nめちゃくちゃテンション上がるし♪",
            "enText": "Especially when you hit the ball! \nThe sound of the metal bat colliding \nwith the ball is the best!♪",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": 7604707535445871611,
            "blockIdx": 7
        },
        {
            "jpName": "メジロマックイーン",
            "enName": "Mejiro McQueen",
            "jpText": "ま、まあ……\nそこまで言うのならご一緒しても――",
            "enText": "W-Well… I suppose you leave me \nwith no choice but to ——",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": -8039398203129015968,
            "blockIdx": 8
        },
        {
            "jpName": "トウカイテイオー",
            "enName": "Tokai Teio",
            "jpText": "やったー！\r\n審判やれる子がいなくて困ってたんだよね！",
            "enText": "Yippee! We needed an umpire to play, \nso this is perfect!",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": 5921600794605798829,
            "blockIdx": 9
        },
        {
            "jpName": "メジロマックイーン",
            "enName": "Mejiro McQueen",
            "jpText": "審判！？　ちょっと！\r\nそれじゃ打てないじゃありませんの！！",
            "enText": "Umpire?! Now hold on! The umpire \ndoesn't get to hit the ball at all!!",
            "nextBlock": -1,
            "voiceIdx": 9,
            "pathId": 4692748583812178446,
            "blockIdx": 10
        }
    ],
    "modified": 1776627616,
    "humanTl": true
}