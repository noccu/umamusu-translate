    "text": [
        {
            "jpName": "メジロライアン",
            "enName": "Mejiro Ryan",
            "jpText": "誕生日おめでとう、パーマー！",
            "enText": "Happy birthday, Palmer!",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": 2996822891421624602,
            "blockIdx": 1
        },
        {
            "jpName": "メジロマックイーン",
            "enName": "Mejiro McQueen",
            "jpText": "おめでとうございます。",
            "enText": "Happy birthday.",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": 3046268773650166064,
            "blockIdx": 2
        },
        {
            "jpName": "メジロパーマー",
            "enName": "Mejiro Palmer",
            "jpText": "えへへ、2人からお祝いしてもらうと、\r\n私もメジロ家なんだって実感するよ。",
            "enText": "Hehe, hearing that from you two really \nmakes me feel like a proper Mejiro.",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": -8716780520392312649,
            "blockIdx": 3
        },
        {
            "jpName": "メジロマックイーン",
            "enName": "Mejiro McQueen",
            "jpText": "なにを言っていますの、パーマーだって\r\nれっきとしたメジロ家のウマ娘ですわ。",
            "enText": "What are you saying? Of course you're \na proper member of the Mejiro family.",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": -7495427662057645324,
            "blockIdx": 4
        },
        {
            "jpName": "メジロライアン",
            "enName": "Mejiro Ryan",
            "jpText": "そうそう、もっと胸を張って\nメジロ家だって主張すればいいんじゃない？",
            "enText": "That's right. You gotta own it — let everybody \nknow you're a Mejiro.",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": 5158250957181266449,
            "blockIdx": 5
        },
        {
            "jpName": "メジロパーマー",
            "enName": "Mejiro Palmer",
            "jpText": "メジロ家を主張……？　そういうの\r\nあんま意識したことなかったな。",
            "enText": "I should own it…? I never really \nsaw it that way.",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 2398754289682837095,
            "blockIdx": 6
        },
        {
            "jpName": "メジロパーマー",
            "enName": "Mejiro Palmer",
            "jpText": "疲れた体にはスイーツですわ、とか\n少女漫画のような恋がしたい、とか？",
            "enText": "Guess I better start saying stuff like \n\"There's no better cure for fatigue than \nsweets.\" or \"I wanna fall in love like \nthe heroine of a romance manga!\"",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": 7199460845010780650,
            "blockIdx": 7
        },
        {
            "jpName": "2人",
            "enName": "Both",
            "jpText": "それはメジロ家と関係ありません！\nそれはメジロ家と関係ないよ！",
            "enText": "That has nothing to do with being a Mejiro! \nThat's not what being a Mejiro's about!",
            "nextBlock": -1,
            "voiceIdx": 7,
            "pathId": 5500689116259908585,
            "blockIdx": 8
        }
    ],
    "humanTl": true,
    "modified": 1784225192
}