            "pathId": -465865680188174663,
            "blockIdx": 17
        },
        {
            "jpName": "ビコーペガサス",
            "enName": "Biko Pegasus",
            "jpText": "そっか、そうだよな……ワルって、ウインディ先輩だもんな。",
            "enText": "Yeah… You're right. \nYou're the baddest bad guy I know.",
            "nextBlock": 19,
            "origClipLength": 178,
            "voiceIdx": 17,
            "animData": [
                {
                    "origLen": 80,
                    "pathId": 5111429699148677522
                },
                {
                    "origLen": 20,
