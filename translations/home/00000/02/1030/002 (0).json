    "text": [
        {
            "jpName": "ライスシャワー",
            "enName": "Rice Shower",
            "jpText": "あ、あの、ウララちゃん。\r\n今日あげるって約束してた、クッキーね……！",
            "enText": "U-Um, Urara… About those cookies\nI promised you today…",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": -8234355861827669190,
            "blockIdx": 1
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "おおっ、焼けた？\r\n楽しみにしてたよー！！",
            "enText": "Oh, are they done already?\nCan I have one now?!",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": 6771868065511141327,
            "blockIdx": 2
        },
        {
            "jpName": "ライスシャワー",
            "enName": "Rice Shower",
            "jpText": "ち、ちがうの！\r\nお塩とお砂糖、間違えて入れちゃったの……！",
            "enText": "N-No! You can't! I accidentally mixed up\nthe sugar and the salt when making them…",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": 4234181316761845129,
            "blockIdx": 3
        },
        {
            "jpName": "ライスシャワー",
            "enName": "Rice Shower",
            "jpText": "楽しみにしてくれてたのに、ごめんね……。\r\nライス、だめな子だ……。",
            "enText": "I'm sorry, I know you were really\nlooking forward to those cookies…\nI'm the worst friend ever…",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": 88806281941969425,
            "blockIdx": 4
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "しょっぱいクッキー！？\r\nいいよー！　食べる食べるー！",
            "enText": "Wait, salty cookies?! That sounds great!\nI wanna eat 'em!",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": 7588276943349426720,
            "blockIdx": 5
        },
        {
            "jpName": "ライスシャワー",
            "enName": "Rice Shower",
            "jpText": "えっ……！？\r\nで、でも……甘くないんだよ？",
            "enText": "Huh?! B-But they won't be sweet at all.",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 6572580769842830080,
            "blockIdx": 6
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "運動したあとだし、しょっぱいの\r\nぜったいおいしいよー！",
            "enText": "But salty snacks after exercising are the best!\nI'm sure your cookies will be good too!",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": 7861826048437738955,
            "blockIdx": 7
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "あとでもらいに行くねー！！",
            "enText": "I'll come by to pick 'em up later, okay?",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": 7451282647523369546,
            "blockIdx": 8
        },
        {
            "jpName": "ライスシャワー",
            "enName": "Rice Shower",
            "jpText": "……っ！\r\nうん、うん……！\nありがとう、ウララちゃん……！",
            "enText": "O-Okay! Thank you, Urara!",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": 8381942809549519416,
            "blockIdx": 9
        },
        {
            "jpName": "ライスシャワー",
            "enName": "Rice Shower",
            "jpText": "……いつも、ほんとにありがと……。",
            "enText": "Really… Thank you so, so much…",
            "nextBlock": -1,
            "voiceIdx": 9,
            "pathId": 5351980100852110638,
            "blockIdx": 10
        }
    ],
