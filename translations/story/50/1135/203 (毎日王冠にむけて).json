                },
                {
                    "origLen": 173,
                    "pathId": -857234168610703074
                }
            ],
            "pathId": 6909282233890062048,
            "blockIdx": 22
        },
        {
            "jpName": "サイレンススズカ",
            "enName": "Silence Suzuka",
            "jpText": "…………――",
            "enText": "…………",
            "nextBlock": 24,
            "origClipLength": 97,
            "voiceIdx": -1,
            "animData": [
                {
                    "origLen": 181,
                    "pathId": 7386512832717695530
                },
