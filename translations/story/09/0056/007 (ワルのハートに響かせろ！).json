                {
                    "origLen": 52,
                    "pathId": -4500802149077670829
                }
            ],
            "pathId": 2901758258543157878,
            "blockIdx": 16
        },
        {
            "jpName": "シンコウウインディ",
            "enName": "Shinko Windy",
            "jpText": "絶対大丈夫なのだ！\nワルの考えは全部わかるのだ。だってワルだからな！",
            "enText": "It'll be okay, promise! \nI know all about how bad guys think. 'Cuz I'm a bad guy too!",
            "nextBlock": 18,
            "origClipLength": 207,
            "voiceIdx": 16,
            "animData": [
                {
                    "origLen": 243,
                    "pathId": -2334213333361743777
                },
                {
                    "origLen": 206,
                    "pathId": 4277354243270474563
