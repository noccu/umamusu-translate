            "pathId": 9074775690954095290,
            "blockIdx": 29
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "Fancy that!　あなた、あんなこともできたのね。\nみんなすごい盛り上がりだったわよ。",
            "enText": "Fancy that! You were able to do something like that. \nEveryone was really fired up.",
            "nextBlock": 31,
            "origClipLength": 228,
            "voiceIdx": 22,
            "choices": [
                {
                    "jpText": "アハハ……楽しんでくれたならなにより",
                    "enText": "Ahaha……I'm glad they enjoyed it",
                    "nextBlock": 31
