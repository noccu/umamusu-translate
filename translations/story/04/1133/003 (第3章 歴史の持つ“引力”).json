                },
                {
                    "origLen": 20,
                    "pathId": 8070122905979649915
                }
            ],
            "pathId": -8563702601756358236,
            "blockIdx": 33
        },
        {
            "jpName": "",
            "enName": "",
            "jpText": "息の上がったクロノジェネシスに『お疲れ様』と声をかける。\nそのあとで、さっきの走りについて感想を伝えた。",
            "enText": "I call out \"Good work\" to a breathless Chrono Genesis. Afterward, I share my thoughts with her about that run she just did.",
            "nextBlock": 35,
            "origClipLength": 112,
            "voiceIdx": -1,
            "choices": [
                {
                    "jpText": "大逃げは、さすがに自由すぎるかも……！",
                    "enText": "A runaway like that might be a bit too much…!",
                    "nextBlock": 35
                }
