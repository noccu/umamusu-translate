            "pathId": -81461078086263980,
            "blockIdx": 25
        },
        {
            "jpName": "シンコウウインディ",
            "enName": "Shinko Windy",
            "jpText": "そ、空耳なのだっ！　そんなこと言ってないし！\n保管室の調査なんか、キレイさっぱり忘れちゃったのだ！",
            "enText": "N-no you didn't! I totally didn't say that! \nI don't even care about the investigation anymore! Nope!",
            "nextBlock": 27,
            "origClipLength": 202,
            "voiceIdx": 25,
            "animData": [
                {
                    "origLen": 168,
                    "pathId": 1316230351112125583
                },
