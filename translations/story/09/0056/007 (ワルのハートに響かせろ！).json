            "pathId": -6721115851465535454,
            "blockIdx": 5
        },
        {
            "jpName": "シンコウウインディ",
            "enName": "Shinko Windy",
            "jpText": "――ワルを動かすなら、ワル流が必要なのだ。",
            "enText": "If we want the bad guys to make a move, \nwe need to think like bad guys.",
            "nextBlock": 7,
            "origClipLength": 152,
            "voiceIdx": 5,
            "animData": [
                {
                    "origLen": 217,
                    "pathId": -1603881581861836849
                },
                {
                    "origLen": 256,
                    "pathId": -3916153850585153435
                },
                {
                    "origLen": 273,
                    "pathId": 4083154447682445442
                },
                {
                    "origLen": 219,
                    "pathId": -5659640352484722310
                },
                {
                    "origLen": 21,
