            "blockIdx": 22
        },
        {
            "jpName": "ネオユニヴァース",
            "enName": "Neo Universe",
            "jpText": "ネオユニヴァースは『がんばる』をするよ。",
            "enText": "Neo Universe will apply Effort.",
            "nextBlock": 24,
            "origClipLength": 71,
            "voiceIdx": 5,
            "animData": [
                {
                    "origLen": 42,
                    "pathId": 2951979710474795020
