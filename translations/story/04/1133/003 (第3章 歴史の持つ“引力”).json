        },
        {
            "jpName": "クロノジェネシス",
            "enName": "Chrono Genesis",
            "jpText": "なるほどです……\n私にとって、歴史とは――あっ。",
            "enText": "I see…… \nWhat history means to me is—oh.",
            "nextBlock": 44,
            "origClipLength": 208,
            "voiceIdx": 31,
            "choices": [
