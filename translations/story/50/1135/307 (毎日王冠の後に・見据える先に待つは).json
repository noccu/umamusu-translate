            "pathId": 6114544114811272579,
            "blockIdx": 23
        },
        {
            "jpName": "ステイゴールド",
            "enName": "Stay Gold",
            "jpText": "……そう、早過ぎるんだよな。",
            "enText": "…Yeah, she's too fast.",
