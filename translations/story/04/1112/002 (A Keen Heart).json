            "pathId": -6210526595454802211,
            "blockIdx": 34
        },
        {
            "jpName": "デアリングハート",
            "enName": "Daring Heart",
            "jpText": "私、このまま外を走ってくるわ。\n悪いけど、バッグ、とってくれる？",
            "enText": "I'm going to go for a run outside. \nSorry, but could you get my bag?",
            "nextBlock": 36,
