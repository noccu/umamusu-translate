    "text": [
        {
            "jpName": "テイエムオペラオー",
            "enName": "T.M. Opera O",
            "jpText": "はーっはっはっは！　探したよ\r\nアヤベさん！　ハッピーバースデー！",
            "enText": "Haaa-ha-ha-ha! There you are, Ayabe! \nHappy birthday!",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": 4753597163809012079,
            "blockIdx": 1
        },
        {
            "jpName": "アドマイヤベガ",
            "enName": "Admire Vega",
            "jpText": "構わないで。\nあなたが横にいると変に目立つのよ。",
            "enText": "Don't bother me. You being around always \nattracts unwanted attention.",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": 3060124346299403385,
            "blockIdx": 2
        },
        {
            "jpName": "テイエムオペラオー",
            "enName": "T.M. Opera O",
            "jpText": "おっとボクの存在が眩しすぎたかい？\r\nでも今日ばかりは少し我慢しておくれ！",
            "enText": "Oh, is my presence too dazzling for you? \nBut I must ask you to bear with me, just \nfor today!",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": -4826341471908212600,
            "blockIdx": 3
        },
        {
            "jpName": "テイエムオペラオー",
            "enName": "T.M. Opera O",
            "jpText": "君に捧げる美しきア・カペラを、ドトウと\n用意してきたんだ！　特等席でご覧あれ！",
            "enText": "For I am here to give you a beautiful \n<i>a cappella</i> performance with Doto! \nAnd you get a VIP seat!",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": -8401266610565061045,
            "blockIdx": 4
        },
        {
            "jpName": "アドマイヤベガ",
            "enName": "Admire Vega",
            "jpText": "いいってば。",
            "enText": "That's okay.",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": -1823806331446102484,
            "blockIdx": 5
        },
        {
            "jpName": "テイエムオペラオー",
            "enName": "T.M. Opera O",
            "jpText": "嗚呼、乾杯しよう～♪\nボクの輝く世界に生まれし君を～♪",
            "enText": "Ahh, let us drink♪ To you, who were born \ninto my shining wooorld♪",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 3192108525098854783,
            "blockIdx": 6
        },
        {
            "jpName": "メイショウドトウ",
            "enName": "Meisho Doto",
            "jpText": "ル～♪\nハッピー・デー……♪",
            "enText": "Laaa…♪ \nA happy day…♪",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": 796949172617463810,
            "blockIdx": 7
        },
        {
            "jpName": "アドマイヤベガ",
            "enName": "Admire Vega",
            "jpText": "はあ！？　ちょ、ちょっと！\nこんなとこでやめてよっ。",
            "enText": "What are you — c-cut it out!\nWe're in public!",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": -5148671642376808218,
            "blockIdx": 8
        },
        {
            "jpName": "テイエムオペラオー",
            "enName": "T.M. Opera O",
            "jpText": "嗚呼、乾杯しよう～♪\n祝福の盃とともに、この素晴らしき日を～♪",
            "enText": "Ahh, let us drink♪ Raise a glass in \ncelebration of this wonderful daaay♪",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": -1324905148577009693,
            "blockIdx": 9
        },
        {
            "jpName": "メイショウドトウ",
            "enName": "Meisho Doto",
            "jpText": "ワ～……♪\nハッピー、バース、デー……！",
            "enText": "Aaah…♪\nHappy birthday!",
            "nextBlock": 11,
            "voiceIdx": 9,
            "pathId": -4677289878484987080,
            "blockIdx": 10
        },
        {
            "jpName": "テイエムオペラオー",
            "enName": "T.M. Opera O",
            "jpText": "ブラーヴァッ！",
            "enText": "Braaava!",
            "nextBlock": 12,
            "voiceIdx": 10,
            "pathId": 1147719406543913665,
            "blockIdx": 11
        },
        {
            "jpName": "アドマイヤベガ",
            "enName": "Admire Vega",
            "jpText": "ちょっともう、\nみんなこっち見てるじゃないの！",
