        {
            "jpName": "ウイニングチケット",
            "enName": "Winning Ticket",
            "jpText": "ねえねえねえねえねえねえねえねえねえ\r\nねえねえタイシーーーンッッッ！！！！",
            "enText": "Hey, hey, hey, hey, hey, hey, hey,\nhey, hey, hey, Taaaiiishhhiiin!!!",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": -8227310158260123345,
            "blockIdx": 1
        },
        {
            "jpName": "ナリタタイシン",
            "enName": "Narita Taishin",
            "jpText": "うるっさ……。\n音聞こえないんだけど。",
            "enText": "Shut up… I can't hear the sound.",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": 2202572755354428030,
            "blockIdx": 2
        },
        {
            "jpName": "ビワハヤヒデ",
            "enName": "Biwa Hayahide",
            "jpText": "タイシン。チケットは暇を\n持て余しているんだ。どうする？",
            "enText": "Taishin. It appears Ticket is overflowing\nwith energy. What will you do?",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": 7860153152519209767,
            "blockIdx": 3
        },
        {
            "jpName": "ナリタタイシン",
            "enName": "Narita Taishin",
            "jpText": "無視。\nゲームのが面白いし。",
            "enText": "Ignore her. This game's just getting good.",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": 6773919257896239030,
            "blockIdx": 4
        },
        {
            "jpName": "ウイニングチケット",
            "enName": "Winning Ticket",
            "jpText": "ゲーム……ゲーム……\nゲームムムムムム……！",
            "enText": "Game? Game… A gaaaaame!",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": 3112940204286578396,
            "blockIdx": 5
        },
        {
            "jpName": "ウイニングチケット",
            "enName": "Winning Ticket",
            "jpText": "ハイハイハイハーイッ！！\r\nゲームならアタシもオススメだよ！",
            "enText": "I know, I know, I knooow!\nI have a game we can all play!",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": -2751745434201734826,
            "blockIdx": 6
        },
        {
            "jpName": "ビワハヤヒデ",
            "enName": "Biwa Hayahide",
            "jpText": "ほう？\n『アタシも』……とは？",
            "enText": "Oh? And what would that be?",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": 293872430597575349,
            "blockIdx": 7
        },
        {
            "jpName": "ウイニングチケット",
            "enName": "Winning Ticket",
            "jpText": "名付けて、『チケゾーゲーム』！！\nまず、アタシの叫びを聞いて――",
            "enText": "It's called the Tickezo game! First I shout\nsomething REALLY LOUD, and then ——",
            "nextBlock": 9,
            "voiceIdx": 7,
            "pathId": 7833108819660746865,
            "blockIdx": 8
        },
        {
            "jpName": "2人",
            "enName": "Both",
            "jpText": "ない。\nないな。",
            "enText": "Nope.\nNo.",
            "nextBlock": 10,
            "voiceIdx": 8,
            "pathId": -7460290738034689475,
            "blockIdx": 9
        },
        {
            "jpName": "ウイニングチケット",
            "enName": "Winning Ticket",
            "jpText": "ガーーーーンッッ！！\n最後まで言ってないのに～っ！！",
            "enText": "Awwwww!! At least let me finish!",
            "nextBlock": -1,
