    "text": [
        {
            "jpName": "テイエムオペラオー",
            "enName": "T.M. Opera O",
            "jpText": "ああっ、いけないっ！",
            "enText": "Ah, what to do!",
            "nextBlock": 2,
            "voiceIdx": 0,
            "pathId": 358881903305736466,
            "blockIdx": 1
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "どうしたの、オペちゃん？",
            "enText": "What's wrong, Ope?",
            "nextBlock": 3,
            "voiceIdx": 1,
            "pathId": -6919495830206143059,
            "blockIdx": 2
        },
        {
            "jpName": "テイエムオペラオー",
            "enName": "T.M. Opera O",
            "jpText": "ボクがここに立ってしまっては\nポスターの存在が消えてしまうと\n思ってね！",
            "enText": "I was just bemoaning the fact that\nmy very presence here makes these\nposters simply disappear.",
            "nextBlock": 4,
            "voiceIdx": 2,
            "pathId": 1188781078196485837,
            "blockIdx": 3
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "ポスターが消えるの！？\nすごーい！　どうやるの！？",
            "enText": "You can make posters disappear?! Wowie!\nHow're you doing that?!",
            "nextBlock": 5,
            "voiceIdx": 3,
            "pathId": -2235832098632895211,
            "blockIdx": 4
        },
        {
            "jpName": "テイエムオペラオー",
            "enName": "T.M. Opera O",
            "jpText": "なに、ボクほどの輝きがあれば\n無に帰したも同然さ！",
            "enText": "Why, by standing here, of course!\nMy dazzling countenance outshines all!",
            "nextBlock": 6,
            "voiceIdx": 4,
            "pathId": -5949892317269040865,
            "blockIdx": 5
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "輝き？\r\nきらきらすれば消えるってこと？",
            "enText": "Dazzling? You mean light\nmakes them disappear?",
            "nextBlock": 7,
            "voiceIdx": 5,
            "pathId": 1012816177256977853,
            "blockIdx": 6
        },
        {
            "jpName": "ハルウララ",
            "enName": "Haru Urara",
            "jpText": "じゃあちょっとウララ、\r\nかいちゅーでんとー持ってこよっかな！",
            "enText": "Okie-dokie! Then I'll go grab\na flashlight and help!",
            "nextBlock": 8,
            "voiceIdx": 6,
            "pathId": -9164117649199600532,
            "blockIdx": 7
        },
        {
            "jpName": "テイエムオペラオー",
            "enName": "T.M. Opera O",
            "jpText": "……。\r\n懐中電灯……？",
            "enText": "A… A flashlight?",
            "nextBlock": -1,
            "voiceIdx": 7,
            "pathId": 2440051573590470655,
            "blockIdx": 8
        }
